{%- liquid
  assign bg_color = section.settings.bg_color | default: '#d7d1c9'
  assign text_color = section.settings.text_color | default: '#2d3c4b'
  
  assign local_svg = 'ProductCollection_100percentArabica.svg' | asset_url
  assign remote_svg = '//www.thirdwavecoffeeroasters.com/cdn/shop/t/35/assets/ProductCollection_100percentArabica.svg?v=144248819802031950101731674043'
  if section.settings.illustration_image != blank
    assign illustration_url = section.settings.illustration_image | image_url: width: 972
  else
    assign illustration_url = local_svg
  endif

  assign local_photo = 'shop-page-img.jpg' | asset_url
  assign remote_photo = '//www.thirdwavecoffeeroasters.com/cdn/shop/t/35/assets/shop-page-img.jpg?v=22229815226751244011731674044'
  if section.settings.photo_image != blank
    assign photo_url = section.settings.photo_image | image_url: width: 1400
  else
    assign photo_url = local_photo
  endif
-%}

<div class="twc-accurity-section twc-accurity-{{ section.id }} uk-section uk-section-primary recipeDiv uk-padding-remove" id="twc-accurity-{{ section.id }}">
  <div class="uk-container">
    <div class="row">
      <div class="col-md-5 col-sm-12 col-xs-12 mainCon">
        {%- if section.settings.heading != blank -%}
          <h2>{{ section.settings.heading | remove: '<br>' | remove: '<br/>' | remove: '<br />' | replace: '  ', ' ' }}</h2>
        {%- endif -%}

        {%- if section.settings.content != blank -%}
          <p>{{ section.settings.content }}</p>
        {%- endif -%}

        <div class="twc-accurity-illustration">
          <img
            style="max-width: 100%;"
            src="{{ illustration_url }}"
            alt="{{ section.settings.heading | strip_html | escape }}"
            loading="lazy"
            onerror="if(this.src!='{{ remote_svg }}') { this.src='{{ remote_svg }}'; }"
          >
        </div>
      </div>

      <div class="col-md-2 uk-visible@m"></div>

      <div class="col-md-5 col-sm-12 col-xs-12 image-col" style="position: relative; display: block;">
        <div class="makeItemAlignToCorner mainWidth">
          <div>
            <img
              src="{{ photo_url }}"
              alt="{{ section.settings.heading | strip_html | escape }}"
              loading="lazy"
              onerror="if(this.src!='{{ remote_photo }}') { this.src='{{ remote_photo }}'; }"
            >
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,300;0,400;0,700;0,900;1,400&family=Merriweather:ital,wght@0,300;0,400;0,700;1,300;1,400&display=swap');

  /* ==========================================================================
     TWC ACCURITY SECTION (100% ARABICA COFFEE)
     ========================================================================== */
  .twc-accurity-{{ section.id }}.recipeDiv {
    background-color: {{ bg_color }};
    width: 100%;
    position: relative;
    overflow-x: clip;
    box-sizing: border-box;
    padding-top: {{ section.settings.padding_top | default: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 0 }}px;
  }

  .twc-accurity-{{ section.id }} *,
  .twc-accurity-{{ section.id }} *::before,
  .twc-accurity-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  /* UIKit & Bootstrap Container Compatibility */
  .twc-accurity-{{ section.id }} .uk-container {
    max-width: 1400px;
    margin-left: auto;
    margin-right: auto;
    padding-left: 20px;
    padding-right: 20px;
    position: relative;
    box-sizing: border-box;
    width: 100%;
  }

  /* Grid Row */
  .twc-accurity-{{ section.id }} .row {
    display: flex;
    flex-wrap: wrap;
    margin-left: -15px;
    margin-right: -15px;
    align-items: stretch;
  }

  /* Columns */
  .twc-accurity-{{ section.id }} .col-md-5,
  .twc-accurity-{{ section.id }} .col-md-2,
  .twc-accurity-{{ section.id }} .col-sm-12,
  .twc-accurity-{{ section.id }} .col-xs-12 {
    position: relative;
    padding-left: 15px;
    padding-right: 15px;
  }

  /* Left Main Content */
  .twc-accurity-{{ section.id }} .mainCon {
    padding: 50px 20px 50px;
    display: flex;
    flex-direction: column;
  }

  /* Typography */
  .twc-accurity-{{ section.id }} h2 {
    font-family: 'Lato', sans-serif !important;
    font-weight: 500 !important;
    color: {{ text_color }} !important;
    font-size: 32px;
    line-height: 41px !important;
    letter-spacing: 0.5px;
    margin-top: 0;
    margin-bottom: 20px;
    text-transform: uppercase;
  }

  .twc-accurity-{{ section.id }} p {
    font-family: 'Merriweather', Georgia, serif !important;
    font-weight: 300 !important;
    color: {{ text_color }} !important;
    font-size: 12px;
    line-height: 19px !important;
    margin-top: 0;
    margin-bottom: 24px;
    max-width: 450px;
    width: 100%;
  }

  /* Bottom SVG illustration */
  .twc-accurity-{{ section.id }} .twc-accurity-illustration {
    margin-top: auto;
    line-height: 0;
    padding-top: 6px;
  }

  .twc-accurity-{{ section.id }} .twc-accurity-illustration img {
    max-width: 100%;
    width: 100%;
    height: auto;
    display: block;
  }

  /* Right Image Corner Bleed on Desktop */
  .twc-accurity-{{ section.id }} .makeItemAlignToCorner {
    left: 0;
    position: relative;
    width: 100%;
    z-index: 2;
  }

  @media (min-width: 960px) {
    .twc-accurity-{{ section.id }} .row {
      align-items: stretch;
    }

    .twc-accurity-{{ section.id }} .col-md-5.mainCon {
      flex: 0 0 45%;
      max-width: 45%;
      width: 45%;
    }

    .twc-accurity-{{ section.id }} .col-md-2.uk-visible\@m {
      flex: 0 0 10%;
      max-width: 10%;
      width: 10%;
      display: block !important;
    }

    .twc-accurity-{{ section.id }} .col-md-5.image-col {
      flex: 0 0 45%;
      max-width: 45%;
      width: 45%;
      display: flex !important;
      flex-direction: column;
      padding-right: 0;
    }

    .twc-accurity-{{ section.id }} .makeItemAlignToCorner {
      flex: 1;
      display: flex;
      min-height: 100%;
      max-height: 480px;
      /* CSS fallback if JS hasn't run yet */
      width: calc(100% + max(0px, (100vw - 1200px) / 2 + 15px));
    }

    .twc-accurity-{{ section.id }} .makeItemAlignToCorner > div {
      flex: 1;
      width: 100%;
      height: 100%;
      min-height: 100%;
      display: flex;
    }

    .twc-accurity-{{ section.id }} .makeItemAlignToCorner img {
      width: 100%;
      height: 100%;
      min-height: 100%;
      max-height: 480px;
      object-fit: cover;
      object-position: center center;
      display: block;
    }
  }

  /* Mobile and Tablet Styles */
  @media (max-width: 959px) {
    .twc-accurity-{{ section.id }} .col-md-2.uk-visible\@m {
      display: none !important;
    }

    .twc-accurity-{{ section.id }} .col-md-5.mainCon,
    .twc-accurity-{{ section.id }} .col-md-5.image-col {
      flex: 0 0 100%;
      max-width: 100%;
      width: 100%;
    }

    .twc-accurity-{{ section.id }} .mainCon {
      padding: 28px 20px 24px;
    }

    .twc-accurity-{{ section.id }} h2 {
      font-size: 24px;
      line-height: 32px !important;
      margin-bottom: 14px;
    }

    .twc-accurity-{{ section.id }} p {
      font-size: 13px;
      line-height: 20px !important;
      margin-bottom: 20px;
    }

    .twc-accurity-{{ section.id }} .twc-accurity-illustration {
      padding-bottom: 0;
    }

    .twc-accurity-{{ section.id }} .twc-accurity-illustration img {
      max-width: 100%;
      margin: 0 auto;
    }

    .twc-accurity-{{ section.id }} .image-col {
      padding-left: 0;
      padding-right: 0;
    }

    .twc-accurity-{{ section.id }} .makeItemAlignToCorner {
      width: 100% !important;
      height: 280px;
    }

    .twc-accurity-{{ section.id }} .makeItemAlignToCorner > div {
      width: 100%;
      height: 100%;
    }

    .twc-accurity-{{ section.id }} .makeItemAlignToCorner img {
      width: 100%;
      height: 100%;
      max-height: 280px;
      object-fit: cover;
      display: block;
    }
  }

  @media (max-width: 480px) {
    .twc-accurity-{{ section.id }} .mainCon {
      padding: 24px 16px 20px;
    }

    .twc-accurity-{{ section.id }} h2 {
      font-size: 21px;
      line-height: 28px !important;
    }

    .twc-accurity-{{ section.id }} .makeItemAlignToCorner {
      height: 240px;
    }

    .twc-accurity-{{ section.id }} h2 {
      font-size: 21px;
      line-height: 28px !important;
    }

    .twc-accurity-{{ section.id }} .makeItemAlignToCorner {
      height: 280px;
    }
  }
</style>

<script>
  (function () {
    function alignCornerBleed() {
      var section = document.getElementById('twc-accurity-{{ section.id }}');
      if (!section) return;
      var isDesktop = window.matchMedia('(min-width: 960px)').matches;
      var cornerItem = section.querySelector('.makeItemAlignToCorner');
      var parentCol = cornerItem ? cornerItem.parentElement : null;

      if (isDesktop && cornerItem && parentCol) {
        var parentRect = parentCol.getBoundingClientRect();
        // Exact pixel distance from column's left edge to right viewport boundary
        var targetWidth = window.innerWidth - parentRect.left;
        if (targetWidth > 0) {
          cornerItem.style.setProperty('width', targetWidth + 'px', 'important');
        }
      } else if (cornerItem) {
        cornerItem.style.removeProperty('width');
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function () {
        alignCornerBleed();
        setTimeout(alignCornerBleed, 60);
      });
    } else {
      alignCornerBleed();
      setTimeout(alignCornerBleed, 60);
    }

    window.addEventListener('resize', alignCornerBleed, { passive: true });
    window.addEventListener('load', alignCornerBleed);

    document.addEventListener('shopify:section:load', function (e) {
      if (e.target && e.target.querySelector('#twc-accurity-{{ section.id }}')) {
        alignCornerBleed();
      }
    });
  })();
</script>

{% schema %}
{
  "name": "TWC Accurity Section",
  "tag": "section",
  "class": "twc-accurity-section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "100% ARABICA COFFEE, SOURCED RESPONSIBLY, ROASTED CAREFULLY."
    },
    {
      "type": "textarea",
      "id": "content",
      "label": "Content Text",
      "default": "Our coffee is 100% Arabica and contains no preservatives or additives. We directly source it from farms, working closely with growers to make sure that your coffee is of the highest quality, grown sustainably and traded ethically. Our selections are specially roasted in our in-house, state-of-the-art roaster with specific profiles to ensure optimal flavour notes. True to our namesake, we pay close attention to every link in the supply chain and every detail of the coffee experience."
    },
    {
      "type": "image_picker",
      "id": "illustration_image",
      "label": "Custom Illustration Image",
      "info": "Upload custom SVG/image or leave blank for default 100% Arabica illustration"
    },
    {
      "type": "image_picker",
      "id": "photo_image",
      "label": "Right Side Photograph",
      "info": "Upload custom photo or leave blank for default coffee farmer photo"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#d7d1c9"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2d3c4b"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "TWC Accurity Section"
    }
  ]
}
{% endschema %}
