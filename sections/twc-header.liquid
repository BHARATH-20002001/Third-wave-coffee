<script>
  (function(){
    // 1. Efficient Cart Count Synchronization
    function setCounts(c){
      if(c!=null) document.querySelectorAll('.twc-cart-count').forEach(function(el){ el.textContent = c; });
    }
    function fetchCart(){
      fetch((window.Shopify?.routes?.root || '/') + 'cart.js')
        .then(function(r){ return r.ok ? r.json() : null; })
        .then(function(d){ if(d && typeof d.item_count === 'number') setCounts(d.item_count); })
        .catch(function(){});
    }
    document.addEventListener('shopify:cart:lines-update', function(e){
      if(typeof e.detail?.itemCount === 'number') setCounts(e.detail.itemCount);
      else if(e.promise) e.promise.then(function(r){
        var n = r?.cart?.totalQuantity ?? r?.cart?.item_count ?? r?.detail?.itemCount;
        n !== undefined ? setCounts(n) : fetchCart();
      }).catch(fetchCart);
      else fetchCart();
    });
    ['cart:updated','cart:refresh','cart-update'].forEach(function(ev){ document.addEventListener(ev, fetchCart); });
    var _fetch = window.fetch;
    window.fetch = async function(){
      var res = await _fetch.apply(this, arguments);
      try {
        var u = typeof arguments[0] === 'string' ? arguments[0] : (arguments[0]?.url || '');
        if(/\/cart\/(add|change|clear|update)/.test(u)) setTimeout(fetchCart, 350);
      } catch(e){}
      return res;
    };
    window.addEventListener('pageshow', function(e){ if(e.persisted) fetchCart(); });

    // 2. Mobile Slide-In Drawer Logic
    var drawer = document.getElementById('twc-mobile-drawer');
    var overlay = document.getElementById('twc-drawer-overlay');
    function toggleDrawer(open){
      if(!drawer || !overlay) return;
      var state = open !== undefined ? open : !drawer.classList.contains('is-open');
      drawer.classList.toggle('is-open', state);
      overlay.classList.toggle('is-open', state);
      document.body.style.overflow = state ? 'hidden' : '';
    }
    document.getElementById('twc-drawer-open')?.addEventListener('click', function(){ toggleDrawer(true); });
    document.getElementById('twc-drawer-close')?.addEventListener('click', function(){ toggleDrawer(false); });
    overlay?.addEventListener('click', function(){ toggleDrawer(false); });
    document.addEventListener('keydown', function(e){ if(e.key === 'Escape') toggleDrawer(false); });

    // 3. Submenu Accordion Toggles (+)
    document.querySelectorAll('.twc-drawer-acc-btn').forEach(function(btn){
      btn.addEventListener('click', function(e){
        e.preventDefault();
        var item = btn.closest('.twc-drawer-item');
        if(!item) return;
        var expanded = item.classList.toggle('is-expanded');
        btn.setAttribute('aria-expanded', expanded ? 'true' : 'false');
        btn.textContent = expanded ? '−' : '+';
      });
    });

    // 4. Cart Drawer & Search Modal Delegation
    document.addEventListener('click', function(e){
      var cBtn = e.target.closest('.twc-cart-trigger');
      if(cBtn){
        var cd = document.getElementById('cart-drawer');
        if(cd){
          if(typeof cd.show === 'function') cd.show();
          else cd.toggleAttribute('open');
        } else {
          window.location.href = '{{ routes.cart_url }}';
        }
        return;
      }
      var sBtn = e.target.closest('.twc-search-trigger');
      if(sBtn){
        var sm = document.getElementById('search-modal');
        var d = sm?.querySelector('dialog');
        if(d?.showModal) try { d.showModal(); } catch(_){}
        else window.location.href = '{{ routes.search_url }}';
      }
    });
  })();
</script>

