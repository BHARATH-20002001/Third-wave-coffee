{%- doc -%}
  Third Wave Coffee Header Section:
  - Left navigation menu & Right navigation menu (selectable in theme)
  - Centered brand logo with 130px height, 100% width
  - Right container 1: Menu
  - Right container 2: Quick links (Account, Cart text [10px #A1A0A5], Search)
  - Main background #EEE2E1
  - Menu font style: 14px Lato, sans-serif, #2D3C4B, 0px 15px padding, 400 font-weight
  - Mobile version:
    * Slide-in menu from left with background #2D3C4B and white font
    * Close button (✕) and accordion submenus (+)
    * Mobile right-side quick links: configurable to show Account and Search only (default)
  - Fully optimized and minified runtime script with dynamic cart update
{%- enddoc -%}

<header
  id="header-component"
  class="twc-header-wrapper{% if section.settings.enable_sticky_header %} twc-header-wrapper--sticky{% endif %}"
  style="
    --twc-header-bg: {{ section.settings.bg_color | default: '#EEE2E1' }};
    --twc-header-text: {{ section.settings.text_color | default: '#2D3C4B' }};
    --twc-header-icon: {{ section.settings.icon_color | default: '#A1A0A5' }};
    --twc-header-badge-bg: {{ section.settings.cart_badge_bg | default: '#2D3C4B' }};
    --twc-header-badge-text: {{ section.settings.cart_badge_text | default: '#ffffff' }};
    --twc-header-logo-height: {{ section.settings.logo_height | default: 130 }}px;
    --twc-header-logo-height-mobile: {{ section.settings.logo_height_mobile | default: 70 }}px;
    --twc-header-padding-top: {{ section.settings.padding_top | default: 0 }}px;
    --twc-header-padding-bottom: {{ section.settings.padding_bottom | default: 0 }}px;
  "
>
  <div class="twc-header">
    <!-- Left Navigation Menu (Desktop) / Mobile Toggle -->
    <div class="twc-header__left">
      <button
        type="button"
        class="twc-header__mobile-toggle"
        aria-label="Open navigation menu"
        id="twc-drawer-open"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>

      <nav class="twc-header__nav twc-header__nav--left" aria-label="Main Left Menu">
        <ul class="twc-header__menu-list">
          {%- if section.settings.left_menu != blank and linklists[section.settings.left_menu].links.size > 0 -%}
            {%- for link in linklists[section.settings.left_menu].links -%}
              <li class="twc-header__menu-item">
                <a href="{{ link.url }}" class="twc-header__menu-link{% if link.current or link.child_active %} is-active{% endif %}">
                  {{ link.title }}
                </a>
              </li>
            {%- endfor -%}
          {%- else -%}
            <li class="twc-header__menu-item"><a href="{{ routes.all_products_collection_url }}" class="twc-header__menu-link is-active">SHOP</a></li>
            <li class="twc-header__menu-item"><a href="#" class="twc-header__menu-link">LEARN &amp; DO</a></li>
            <li class="twc-header__menu-item"><a href="#" class="twc-header__menu-link">CAFES</a></li>
            <li class="twc-header__menu-item"><a href="#" class="twc-header__menu-link">SUBSCRIBE</a></li>
          {%- endif -%}
        </ul>
      </nav>
    </div>

    <!-- Center Brand Logo (130px height, 100% width) -->
    <div class="twc-header__center">
      <a href="{{ routes.root_url }}" class="twc-header__logo-link" aria-label="{{ shop.name }}">
        {%- if section.settings.logo != blank -%}
          <img
            src="{{ section.settings.logo | image_url }}"
            alt="{{ section.settings.logo.alt | default: shop.name | escape }}"
            class="twc-header__logo-img"
            width="{{ section.settings.logo.width }}"
            height="{{ section.settings.logo_height | default: 130 }}"
            loading="eager"
          >
        {%- else -%}
          <svg class="twc-header__logo-svg" viewBox="0 0 240 130" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Third Wave Coffee">
            <g transform="translate(85, 12)">
              <path d="M6 14 Q35 11 64 14 L61 38 Q35 52 9 38 Z" fill="var(--twc-header-text, #233342)"/>
              <path d="M63 18 Q76 21 76 27 Q76 33 60 35" stroke="var(--twc-header-text, #233342)" stroke-width="3.5" fill="none" stroke-linecap="round"/>
              <ellipse cx="35" cy="14" rx="29" ry="5" fill="var(--twc-header-text, #233342)"/>
              <path d="M12 18 Q23 13 35 18 Q47 23 58 17" stroke="var(--twc-header-bg, #EEE2E1)" stroke-width="2.5" fill="none" stroke-linecap="round"/>
              <path d="M16 25 Q26 21 35 25 Q45 29 54 24" stroke="var(--twc-header-bg, #EEE2E1)" stroke-width="2" fill="none" stroke-linecap="round"/>
            </g>
            <text x="120" y="86" text-anchor="middle" font-family="'Lato', sans-serif" font-size="17" font-weight="900" fill="var(--twc-header-text, #233342)" letter-spacing="1.5">THIRD WAVE<tspan font-size="10" dy="-6">®</tspan></text>
            <text x="120" y="106" text-anchor="middle" font-family="'Lato', sans-serif" font-size="14" font-weight="900" fill="var(--twc-header-text, #233342)" letter-spacing="4">COFFEE</text>
          </svg>
        {%- endif -%}
      </a>
    </div>

    <!-- Right Side Containers -->
    <div class="twc-header__right">
      <!-- Container 1: Right Menu (Desktop) -->
      <nav class="twc-header__right-menu" aria-label="Right Menu">
        <ul class="twc-header__menu-list">
          {%- if section.settings.right_menu != blank and linklists[section.settings.right_menu].links.size > 0 -%}
            {%- for link in linklists[section.settings.right_menu].links -%}
              <li class="twc-header__menu-item">
                <a href="{{ link.url }}" class="twc-header__menu-link{% if link.current or link.child_active %} is-active{% endif %}">
                  {{ link.title }}
                </a>
              </li>
            {%- endfor -%}
          {%- else -%}
            <li class="twc-header__menu-item"><a href="#" class="twc-header__menu-link">CONTACT</a></li>
            <li class="twc-header__menu-item"><a href="#" class="twc-header__menu-link">ABOUT</a></li>
          {%- endif -%}
        </ul>
      </nav>

      <!-- Container 2: Quick Links (Desktop & Mobile) -->
      <div class="twc-header__quick-links">
        <!-- Desktop Quick Links: Account, Cart text, Search -->
        <div class="twc-header__quick-desktop">
          {%- if section.settings.show_account -%}
            <a href="{{ routes.account_url | default: '/account' }}" class="twc-header__icon-btn" aria-label="Account">
              {%- if section.settings.account_icon != blank -%}
                <img src="{{ section.settings.account_icon | image_url: width: 44 }}" alt="Account" class="twc-header__custom-icon" width="20" height="20">
              {%- else -%}
                <svg class="twc-header__svg-icon" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><circle cx="10" cy="6.5" r="2.75" stroke="currentColor" stroke-width="1.5"/><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="m5.172 14.591-.437.786a.588.588 0 0 0 .514.873h9.502a.588.588 0 0 0 .514-.873l-.437-.786a5.523 5.523 0 0 0-9.656 0"/></svg>
              {%- endif -%}
            </a>
          {%- endif -%}

          {%- if section.settings.show_cart -%}
            <button type="button" class="twc-header__cart-btn twc-cart-trigger header-actions__cart-icon" aria-label="Cart">
              <span class="twc-header__cart-text">
                CART [ <span class="twc-cart-count">{{ cart.item_count }}</span> ]
              </span>
            </button>
          {%- endif -%}

          {%- if section.settings.show_search -%}
            <button type="button" class="twc-header__icon-btn twc-search-trigger" aria-label="Search">
              {%- if section.settings.search_icon != blank -%}
                <img src="{{ section.settings.search_icon | image_url: width: 44 }}" alt="Search" class="twc-header__custom-icon" width="20" height="20">
              {%- else -%}
                <svg class="twc-header__svg-icon" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><circle cx="9" cy="9" r="4.75" stroke="currentColor" stroke-width="1.5"/><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="m12.5 12.5 3.25 3.25"/></svg>
              {%- endif -%}
            </button>
          {%- endif -%}
        </div>

        <!-- Mobile Quick Links -->
        <div class="twc-header__quick-mobile">
          {%- case section.settings.mobile_header_icons -%}
            {%- when 'cart_search' -%}
              <!-- Cart Icon (Mobile) -->
              <button type="button" class="twc-header__icon-btn twc-cart-trigger header-actions__cart-icon" aria-label="Cart">
                <span class="twc-header__cart-icon-wrapper">
                  {%- if section.settings.cart_icon != blank -%}
                    <img src="{{ section.settings.cart_icon | image_url: width: 44 }}" alt="Cart" class="twc-header__custom-icon" width="20" height="20">
                  {%- else -%}
                    <svg class="twc-header__svg-icon" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.392 6.875h13.216v8.016c0 .567-.224 1.112-.624 1.513-.4.402-.941.627-1.506.627H5.522a2.13 2.13 0 0 1-1.506-.627 2.15 2.15 0 0 1-.624-1.513zM8.818 2.969h2.333c.618 0 1.211.247 1.649.686a2.35 2.35 0 0 1 .683 1.658v1.562H6.486V5.313c0-.622.246-1.218.683-1.658a2.33 2.33 0 0 1 1.65-.686"/></svg>
                  {%- endif -%}
                  <span class="twc-header__cart-badge twc-cart-count">{{ cart.item_count }}</span>
                </span>
              </button>
              <!-- Search Icon -->
              <button type="button" class="twc-header__icon-btn twc-search-trigger" aria-label="Search">
                {%- if section.settings.search_icon != blank -%}
                  <img src="{{ section.settings.search_icon | image_url: width: 44 }}" alt="Search" class="twc-header__custom-icon" width="20" height="20">
                {%- else -%}
                  <svg class="twc-header__svg-icon" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><circle cx="9" cy="9" r="4.75" stroke="currentColor" stroke-width="1.5"/><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="m12.5 12.5 3.25 3.25"/></svg>
                {%- endif -%}
              </button>

            {%- when 'all' -%}
              <a href="{{ routes.account_url | default: '/account' }}" class="twc-header__icon-btn" aria-label="Account">
                {%- if section.settings.account_icon != blank -%}
                  <img src="{{ section.settings.account_icon | image_url: width: 44 }}" alt="Account" class="twc-header__custom-icon" width="20" height="20">
                {%- else -%}
                  <svg class="twc-header__svg-icon" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><circle cx="10" cy="6.5" r="2.75" stroke="currentColor" stroke-width="1.5"/><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="m5.172 14.591-.437.786a.588.588 0 0 0 .514.873h9.502a.588.588 0 0 0 .514-.873l-.437-.786a5.523 5.523 0 0 0-9.656 0"/></svg>
                {%- endif -%}
              </a>
              <button type="button" class="twc-header__icon-btn twc-cart-trigger header-actions__cart-icon" aria-label="Cart">
                <span class="twc-header__cart-icon-wrapper">
                  {%- if section.settings.cart_icon != blank -%}
                    <img src="{{ section.settings.cart_icon | image_url: width: 44 }}" alt="Cart" class="twc-header__custom-icon" width="20" height="20">
                  {%- else -%}
                    <svg class="twc-header__svg-icon" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.392 6.875h13.216v8.016c0 .567-.224 1.112-.624 1.513-.4.402-.941.627-1.506.627H5.522a2.13 2.13 0 0 1-1.506-.627 2.15 2.15 0 0 1-.624-1.513zM8.818 2.969h2.333c.618 0 1.211.247 1.649.686a2.35 2.35 0 0 1 .683 1.658v1.562H6.486V5.313c0-.622.246-1.218.683-1.658a2.33 2.33 0 0 1 1.65-.686"/></svg>
                  {%- endif -%}
                  <span class="twc-header__cart-badge twc-cart-count">{{ cart.item_count }}</span>
                </span>
              </button>
              <button type="button" class="twc-header__icon-btn twc-search-trigger" aria-label="Search">
                {%- if section.settings.search_icon != blank -%}
                  <img src="{{ section.settings.search_icon | image_url: width: 44 }}" alt="Search" class="twc-header__custom-icon" width="20" height="20">
                {%- else -%}
                  <svg class="twc-header__svg-icon" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><circle cx="9" cy="9" r="4.75" stroke="currentColor" stroke-width="1.5"/><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="m12.5 12.5 3.25 3.25"/></svg>
                {%- endif -%}
              </button>

            {%- else -%}
              <!-- Default: 'account_search' -> Show ONLY account and search option only -->
              {%- if section.settings.show_account -%}
                <a href="{{ routes.account_url | default: '/account' }}" class="twc-header__icon-btn" aria-label="Account">
                  {%- if section.settings.account_icon != blank -%}
                    <img src="{{ section.settings.account_icon | image_url: width: 44 }}" alt="Account" class="twc-header__custom-icon" width="20" height="20">
                  {%- else -%}
                    <svg class="twc-header__svg-icon" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><circle cx="10" cy="6.5" r="2.75" stroke="currentColor" stroke-width="1.5"/><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="m5.172 14.591-.437.786a.588.588 0 0 0 .514.873h9.502a.588.588 0 0 0 .514-.873l-.437-.786a5.523 5.523 0 0 0-9.656 0"/></svg>
                  {%- endif -%}
                </a>
              {%- endif -%}
              {%- if section.settings.show_search -%}
                <button type="button" class="twc-header__icon-btn twc-search-trigger" aria-label="Search">
                  {%- if section.settings.search_icon != blank -%}
                    <img src="{{ section.settings.search_icon | image_url: width: 44 }}" alt="Search" class="twc-header__custom-icon" width="20" height="20">
                  {%- else -%}
                    <svg class="twc-header__svg-icon" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><circle cx="9" cy="9" r="4.75" stroke="currentColor" stroke-width="1.5"/><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="m12.5 12.5 3.25 3.25"/></svg>
                  {%- endif -%}
                </button>
              {%- endif -%}
          {%- endcase -%}
        </div>
      </div>
    </div>
  </div>

  <!-- Mobile Slide-In Drawer from Left (bg #2D3C4B, white font) -->
  <div class="twc-drawer-overlay" id="twc-drawer-overlay"></div>
  <div class="twc-mobile-drawer" id="twc-mobile-drawer" role="dialog" aria-modal="true" aria-label="Mobile Navigation">
    <div class="twc-drawer-header">
      <button type="button" class="twc-drawer-close" id="twc-drawer-close" aria-label="Close menu">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <nav class="twc-drawer-nav">
      <ul class="twc-drawer-list">
        {%- if section.settings.left_menu != blank or section.settings.right_menu != blank -%}
          {%- for link in linklists[section.settings.left_menu].links -%}
            <li class="twc-drawer-item">
              <div class="twc-drawer-row">
                <a href="{{ link.url }}" class="twc-drawer-link">{{ link.title }}</a>
                {%- if link.links.size > 0 -%}
                  <button type="button" class="twc-drawer-acc-btn" aria-label="Toggle submenu" aria-expanded="false">+</button>
                {%- endif -%}
              </div>
              {%- if link.links.size > 0 -%}
                <ul class="twc-drawer-submenu">
                  {%- for child_link in link.links -%}
                    <li><a href="{{ child_link.url }}" class="twc-drawer-sublink">{{ child_link.title }}</a></li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </li>
          {%- endfor -%}
          {%- for link in linklists[section.settings.right_menu].links -%}
            <li class="twc-drawer-item">
              <div class="twc-drawer-row">
                <a href="{{ link.url }}" class="twc-drawer-link">{{ link.title }}</a>
                {%- if link.links.size > 0 -%}
                  <button type="button" class="twc-drawer-acc-btn" aria-label="Toggle submenu" aria-expanded="false">+</button>
                {%- endif -%}
              </div>
              {%- if link.links.size > 0 -%}
                <ul class="twc-drawer-submenu">
                  {%- for child_link in link.links -%}
                    <li><a href="{{ child_link.url }}" class="twc-drawer-sublink">{{ child_link.title }}</a></li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </li>
          {%- endfor -%}
        {%- else -%}
          <!-- Default menu items matching shared image exactly -->
          <li class="twc-drawer-item">
            <div class="twc-drawer-row">
              <a href="{{ routes.all_products_collection_url }}" class="twc-drawer-link">SHOP</a>
              <button type="button" class="twc-drawer-acc-btn" aria-label="Toggle submenu" aria-expanded="false">+</button>
            </div>
            <ul class="twc-drawer-submenu">
              <li><a href="/collections/coffee-beans" class="twc-drawer-sublink">COFFEE BEANS</a></li>
              <li><a href="/collections/ready-to-drink" class="twc-drawer-sublink">EASY COFFEE &amp; RTD</a></li>
              <li><a href="/collections/equipment" class="twc-drawer-sublink">BREWING EQUIPMENT</a></li>
              <li><a href="/collections/merchandise" class="twc-drawer-sublink">MERCHANDISE</a></li>
            </ul>
          </li>
          <li class="twc-drawer-item">
            <div class="twc-drawer-row">
              <a href="#" class="twc-drawer-link">LEARN &amp; DO</a>
              <button type="button" class="twc-drawer-acc-btn" aria-label="Toggle submenu" aria-expanded="false">+</button>
            </div>
            <ul class="twc-drawer-submenu">
              <li><a href="#" class="twc-drawer-sublink">BREW GUIDES</a></li>
              <li><a href="#" class="twc-drawer-sublink">COFFEE STORIES</a></li>
              <li><a href="#" class="twc-drawer-sublink">WORKSHOPS</a></li>
            </ul>
          </li>
          <li class="twc-drawer-item">
            <div class="twc-drawer-row">
              <a href="#" class="twc-drawer-link">ABOUT</a>
              <button type="button" class="twc-drawer-acc-btn" aria-label="Toggle submenu" aria-expanded="false">+</button>
            </div>
            <ul class="twc-drawer-submenu">
              <li><a href="#" class="twc-drawer-sublink">OUR STORY</a></li>
              <li><a href="#" class="twc-drawer-sublink">FARMS &amp; ROASTERY</a></li>
            </ul>
          </li>
          <li class="twc-drawer-item">
            <div class="twc-drawer-row">
              <a href="#" class="twc-drawer-link">CONTACT</a>
            </div>
          </li>
          <li class="twc-drawer-item">
            <div class="twc-drawer-row">
              <a href="#" class="twc-drawer-link">CAFES</a>
            </div>
          </li>
        {%- endif -%}
      </ul>
    </nav>
  </div>
</header>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Lato:wght@300;400;600;700;900&display=swap');

  .twc-header-wrapper {
    background-color: var(--twc-header-bg, #EEE2E1);
    width: 100%;
    position: relative;
    z-index: 100;
    box-sizing: border-box;
    padding-top: var(--twc-header-padding-top, 0px);
    padding-bottom: var(--twc-header-padding-bottom, 0px);
  }
  .twc-header-wrapper--sticky {
    position: sticky;
    top: 0;
    z-index: 999;
  }
  .twc-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 40px;
    box-sizing: border-box;
    min-height: var(--twc-header-logo-height, 130px);
  }

  /* Left Column */
  .twc-header__left {
    flex: 1 1 0;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    min-width: 0;
  }

  /* Center Logo */
  .twc-header__center {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    height: var(--twc-header-logo-height, 130px);
    padding: 0 20px;
  }
  .twc-header__logo-link {
    display: flex;
    align-items: center;
    justify-content: center;
    height: var(--twc-header-logo-height, 130px);
    width: 100%;
    text-decoration: none;
  }
  .twc-header__logo-img {
    height: var(--twc-header-logo-height, 130px);
    width: 100%;
    object-fit: contain;
    display: block;
  }
  .twc-header__logo-svg {
    height: var(--twc-header-logo-height, 130px);
    width: 100%;
    max-width: 220px;
    display: block;
  }

  /* Right Column */
  .twc-header__right {
    flex: 1 1 0;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 32px;
    min-width: 0;
  }
  .twc-header__right-menu {
    display: flex;
    align-items: center;
  }
  .twc-header__quick-links {
    display: flex;
    align-items: center;
  }
  .twc-header__quick-desktop {
    display: flex;
    align-items: center;
    gap: 22px;
  }
  .twc-header__quick-mobile {
    display: none;
    align-items: center;
    gap: 16px;
  }

  /* Navigation Links (14px Lato, #2D3C4B, padding 0px 15px, 400 weight) */
  .twc-header__menu-list {
    display: flex;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
  }
