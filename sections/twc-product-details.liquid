{%- doc -%}
  Third Wave Coffee - Custom Product Details Section
  - Left column:
      * Dusty rose background card for product image with increased height (+100px)
      * Hover zoom lens with real-time cursor tracking
      * Slide-in animation on slide change with higher z-index (10)
      * 4 dots indicator centered at the bottom of the image card
  - Right column:
      * Breadcrumbs (12px Lato, #24394A, underlined links)
      * Product Title (25px Lato, 800 weight, uppercase, margin 40px 0 20px)
      * Flavor notes / Subtitle (18px Lato, #883434, bold, margin 0 0 14px)
      * Rich product description (15px Angsana New, #25394A)
      * Roast profile: 4 dots indicator + roast/coffee type text in #883434
      * GRIND TYPE dropdown with "Guide" modal trigger
      * Dual column: SIZE dropdown & QUANTITY stepper (- 01 +)
      * Price display with live quantity multiplier
      * Dual CTA buttons (container width 400px): ADD TO CART → and BUY NOW → with custom SVG
      * "Subscribe and save!" link
      * 2-column meta footer: "Suitable for :" and "Pairs great with a TWC:"
  - Max-width 1440px matching the header layout, 130px gap on desktop, background #EEE2E1
{%- enddoc -%}

{%- liquid
  # Resolve product object: on product template, global product or closest.product is available
  assign current_product = product | default: closest.product

  # Dynamic Product Title: prioritize current_product.title (no fallback strings)
  assign product_title = current_product.title
  if product_title == blank
    assign product_title = section.settings.title
  endif

  # 1. Product Subtitle: descriptors.subtitle (Single line text) or custom metafields
  assign product_subtitle = current_product.metafields.descriptors.subtitle.value
  if product_subtitle == blank
    assign product_subtitle = current_product.metafields.descriptors.subtitle
  endif
  if product_subtitle == blank
    assign product_subtitle = current_product.metafields.custom.subtitle.value | default: current_product.metafields.custom.subtitle
  endif
  if product_subtitle == blank
    assign product_subtitle = current_product.metafields.custom.flavor_notes.value | default: current_product.metafields.custom.flavor_notes
  endif
  if product_subtitle == blank
    assign product_subtitle = current_product.metafields.custom.product_subtitle.value | default: current_product.metafields.custom.product_subtitle
  endif
  if product_subtitle == blank
    assign product_subtitle = section.settings.flavor_notes
  endif

  # Dynamic Product Description: prioritize current_product.description
  assign product_desc = current_product.description
  if product_desc == blank
    assign product_desc = current_product.metafields.custom.short_description.value | default: current_product.metafields.custom.short_description | default: current_product.metafields.custom.description.value | default: current_product.metafields.custom.description
  endif
  if product_desc == blank
    assign product_desc = section.settings.description
  endif

  # 2. Roast Level: custom.roast_level (Integer)
  assign roast_level = current_product.metafields.custom.roast_level.value | default: current_product.metafields.custom.roast_level
  if roast_level != blank
    assign roast_level_num = roast_level | plus: 0
  else
    assign roast_level_num = 0
  endif

  # 3. Roast Type: custom.roast_type (Single line text)
  assign roast_type = current_product.metafields.custom.roast_type.value | default: current_product.metafields.custom.roast_type

  # 4. Coffee Type: custom.coffee_type (Single line text)
  assign coffee_type = current_product.metafields.custom.coffee_type.value | default: current_product.metafields.custom.coffee_type

  assign current_variant = current_product.selected_or_first_available_variant
  if current_variant and current_variant.price > 0
    assign price_display = current_variant.price | money_without_trailing_zeros
  elsif current_product.price and current_product.price > 0
    assign price_display = current_product.price | money_without_trailing_zeros
  else
    assign price_display = section.settings.price
  endif

  # Free delivery note
  assign free_delivery_text = current_product.metafields.custom.free_delivery_text.value | default: section.settings.free_delivery_text

  # Bottom Meta Details
  assign raw_suitable_for = current_product.metafields.custom.suitable_for.value | default: current_product.metafields.custom.suitable_for
  if raw_suitable_for != blank
    if raw_suitable_for.first != blank
      assign suitable_for_text = raw_suitable_for | join: ', '
    else
      assign suitable_for_text = raw_suitable_for
    endif
  else
    assign suitable_for_text = section.settings.default_suitable_for
  endif

  assign raw_pairs_with = current_product.metafields.custom.great_with_twc.value | default: current_product.metafields.custom.great_with_twc | default: current_product.metafields.custom.pairs_with.value | default: current_product.metafields.custom.pairs_with | default: current_product.metafields.custom.pairs_great_with.value | default: current_product.metafields.custom.pairs_great_with
  if raw_pairs_with != blank
    if raw_pairs_with.first != blank
      assign pairs_with_text = raw_pairs_with | join: ', '
    else
      assign pairs_with_text = raw_pairs_with
    endif
  else
    assign pairs_with_text = section.settings.default_pairs_with
  endif

  assign subscribe_text = section.settings.subscribe_text | default: "Subscribe and save!"
  assign subscribe_url = section.settings.subscribe_url | default: "#subscribe"

  # Resolve Media / Images
  assign product_media = current_product.media | default: current_product.images
  assign has_real_images = false
  if product_media.size > 0
    assign has_real_images = true
    assign total_slides = product_media.size
  else
    assign total_slides = 4
  endif

  # Resolve Grind Sizes (strictly from metafields or options, no fallback list)
  assign raw_grind_sizes = current_product.metafields.custom.grind_sizes.value | default: current_product.metafields.custom.grind_sizes | default: current_product.metafields.custom.grind_size.value | default: current_product.metafields.custom.grind_size
  assign grind_options_list = blank

  if raw_grind_sizes != blank
    if raw_grind_sizes.first != blank
      assign grind_options_list = raw_grind_sizes
    else
      assign grind_options_list = raw_grind_sizes | split: ','
    endif
  else
    for opt in current_product.options_with_values
      assign opt_name_down = opt.name | downcase
      if opt_name_down contains 'grind'
        assign grind_options_list = opt.values
        break
      endif
    endfor
  endif
-%}

<section
  id="twc-product-{{ section.id }}"
  class="twc-product-section"
  style="
    --twc-p-bg: {{ section.settings.bg_color | default: '#EEE2E1' }};
    --twc-p-card-bg: {{ section.settings.card_bg | default: '#cfadab' }};
    --twc-p-navy: {{ section.settings.navy_color | default: '#2D3C4B' }};
    --twc-p-btn-bg: {{ section.settings.btn_bg | default: '#2D3C4B' }};
    --twc-p-mauve: {{ section.settings.mauve_color | default: '#883434' }};
    --twc-p-text-muted: #4A5560;
    --twc-p-select-bg: {{ section.settings.select_bg | default: '#EAE0DF' }};
  "
>
  <div class="twc-product-container">
    <!-- Left Column: Gallery / Carousel -->
    <div class="twc-product__gallery-col">
      <div
        class="twc-product__gallery-box"
        id="twc-gallery-box-{{ section.id }}"
        aria-label="Product Image Gallery (Hover to zoom)"
      >
        <!-- Carousel Track -->
        <div class="twc-gallery__track" id="twc-gallery-track-{{ section.id }}">
          {%- if has_real_images -%}
            {%- for media in product_media -%}
              <div
                class="twc-gallery__slide{% if forloop.first %} is-active{% endif %}"
                data-index="{{ forloop.index0 }}"
                data-media-id="{{ media.id }}"
              >
                {%- if media.media_type == 'image' or media.preview_image -%}
                  <img
                    src="{{ media | image_url: width: 1200 }}"
                    alt="{{ media.alt | default: product_title | escape }}"
                    class="twc-gallery__img"
                    loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                    width="{{ media.width | default: 600 }}"
                    height="{{ media.height | default: 600 }}"
                  >
                {%- else -%}
                  {{ media | media_tag: class: 'twc-gallery__img' }}
                {%- endif -%}
              </div>
            {%- endfor -%}
          {%- else -%}
            <!-- Fallback Static 4 Slides only when product has no images -->
            <div class="twc-gallery__slide is-active" data-index="0">
              <img src="{{ 'twc-vienna-roast-1.jpg' | asset_url }}" alt="{{ product_title }} - View 1" class="twc-gallery__img" loading="eager" width="600" height="600">
            </div>
            <div class="twc-gallery__slide" data-index="1">
              <img src="{{ 'twc-vienna-roast-2.jpg' | asset_url }}" alt="{{ product_title }} - View 2" class="twc-gallery__img" loading="lazy" width="600" height="600">
            </div>
            <div class="twc-gallery__slide" data-index="2">
              <img src="{{ 'twc-vienna-roast-3.jpg' | asset_url }}" alt="{{ product_title }} - View 3" class="twc-gallery__img" loading="lazy" width="600" height="600">
            </div>
            <div class="twc-gallery__slide" data-index="3">
              <img src="{{ 'twc-vienna-roast-4.jpg' | asset_url }}" alt="{{ product_title }} - View 4" class="twc-gallery__img" loading="lazy" width="600" height="600">
            </div>
          {%- endif -%}
        </div>

        {%- if total_slides > 1 -%}
          <!-- Navigation Arrows (subtle on hover) -->
          <button
            type="button"
            class="twc-gallery__nav-arrow twc-gallery__nav-arrow--prev"
            id="twc-prev-{{ section.id }}"
            aria-label="Previous image"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
          </button>

          <button
            type="button"
            class="twc-gallery__nav-arrow twc-gallery__nav-arrow--next"
            id="twc-next-{{ section.id }}"
            aria-label="Next image"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </button>
        {%- endif -%}

        <!-- Pagination Dots Inside Card at Bottom -->
        {%- if total_slides > 1 -%}
          <div class="twc-gallery__dots" id="twc-dots-{{ section.id }}" role="tablist" aria-label="Product Image Carousel Navigation">
            {%- for i in (1..total_slides) -%}
              {%- assign dot_index = forloop.index0 -%}
              <button
                type="button"
                class="twc-gallery__dot{% if forloop.first %} is-active{% endif %}"
                data-index="{{ dot_index }}"
                aria-label="Go to slide {{ forloop.index }}"
              ></button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>

    <!-- Right Column: Product Information -->
    <div class="twc-product__info-col">
      <!-- 1. Breadcrumbs -->
      {%- liquid
        assign current_collection = collection | default: current_product.collections.first
      -%}
      <nav class="twc-breadcrumbs" aria-label="Breadcrumb">
        <a href="{{ routes.all_products_collection_url }}" class="twc-breadcrumb__item">SHOP</a>
        <span class="twc-breadcrumb__sep">&gt;</span>
        {%- if current_collection != blank -%}
          <a href="{{ current_collection.url }}" class="twc-breadcrumb__item">{{ current_collection.title | upcase }}</a>
          <span class="twc-breadcrumb__sep">&gt;</span>
        {%- elsif current_product.type != blank -%}
          <a href="{{ routes.all_products_collection_url }}?filter.p.product_type={{ current_product.type | url_encode }}" class="twc-breadcrumb__item">{{ current_product.type | upcase }}</a>
          <span class="twc-breadcrumb__sep">&gt;</span>
        {%- else -%}
          <a href="{{ routes.all_products_collection_url }}" class="twc-breadcrumb__item">COFFEE</a>
          <span class="twc-breadcrumb__sep">&gt;</span>
        {%- endif -%}
        {%- if product_title != blank -%}
          <span class="twc-breadcrumb__item twc-breadcrumb__item--current">{{ product_title }}</span>
        {%- endif -%}
      </nav>

      <!-- 2. Product Title -->
      {%- if product_title != blank -%}
        <h1 class="twc-product__title">{{ product_title }}</h1>
      {%- endif -%}

      <!-- 3. Flavor Notes / Subtitle -->
      {%- if product_subtitle != blank -%}
        <div class="twc-product__flavor-notes">{{ product_subtitle }}</div>
      {%- endif -%}

      <!-- 4. Description -->
      {%- if product_desc != blank -%}
        <div class="twc-product__description">
          {{ product_desc }}
        </div>
      {%- endif -%}

      <!-- 5. Roast Profile -->
      {%- if roast_level_num > 0 or roast_type != blank or coffee_type != blank -%}
        <div class="twc-product__roast-row">
          {%- if roast_level_num > 0 -%}
            <div class="twc-roast-indicator" title="Roast Level: {{ roast_type }}{% if roast_level_num > 0 %} ({{ roast_level_num }} of 4){% endif %}">
              <span class="twc-roast-dot{% if roast_level_num >= 1 %} is-filled{% endif %}"></span>
              <span class="twc-roast-dot{% if roast_level_num >= 2 %} is-filled{% endif %}"></span>
              <span class="twc-roast-dot{% if roast_level_num >= 3 %} is-filled{% endif %}"></span>
              <span class="twc-roast-dot{% if roast_level_num >= 4 %} is-filled{% endif %}"></span>
            </div>
          {%- endif -%}
          {%- if roast_type != blank or coffee_type != blank -%}
            <span class="twc-roast-text">
              {%- if roast_type != blank and coffee_type != blank -%}
                {{ roast_type }} &nbsp;|&nbsp; {{ coffee_type }}
              {%- elsif roast_type != blank -%}
                {{ roast_type }}
              {%- else -%}
                {{ coffee_type }}
              {%- endif -%}
            </span>
          {%- endif -%}
        </div>
      {%- endif -%}

      <!-- Product Purchase Form -->
      <form
        method="post"
        action="{{ routes.cart_add_url }}"
        id="twc-product-form-{{ section.id }}"
        class="twc-product-form"
        enctype="multipart/form-data"
      >
        <!-- 6. GRIND TYPE Dropdown with Guide link -->
        {%- if grind_options_list != blank -%}
          <div class="twc-field-group">
            <div class="twc-field-header">
              <label for="twc-grind-select-{{ section.id }}" class="twc-field-label">GRIND TYPE</label>
              <button
                type="button"
                class="twc-guide-btn"
                id="twc-open-guide-{{ section.id }}"
                aria-haspopup="dialog"
              >
                Guide
              </button>
            </div>

            <div class="twc-select-container">
              <select
                id="twc-grind-select-{{ section.id }}"
                name="properties[Grind Size]"
                class="twc-select"
              >
                {%- for grind in grind_options_list -%}
                  {%- assign g_clean = grind | strip -%}
                  <option value="{{ g_clean | escape }}" {% if forloop.first %}selected{% endif %}>{{ g_clean }}</option>
                {%- endfor -%}
              </select>
              <span class="twc-select-caret" aria-hidden="true">
                <svg viewBox="0 0 12 8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M1 1.5L6 6.5L11 1.5"/>
                </svg>
              </span>
            </div>
          </div>
        {%- endif -%}

        <!-- 7. Dual Fields: SIZE & QUANTITY Stepper -->
        <div class="twc-dual-fields">
          <!-- Size Column (Shopify Variant Selection) -->
          <div class="twc-field-col">
            <label for="twc-size-select-{{ section.id }}" class="twc-field-label">
              {%- if current_product.variants.size > 0 and current_product.options.size > 0 and current_product.has_only_default_variant == false -%}
                {{ current_product.options.first | upcase }}
              {%- else -%}
                SIZE
              {%- endif -%}
            </label>
            <div class="twc-select-container">
              <select
                id="twc-size-select-{{ section.id }}"
                name="id"
                class="twc-select"
              >
                {%- if current_product.variants.size > 0 -%}
                  {%- for variant in current_product.variants -%}
                    <option
                      value="{{ variant.id }}"
                      data-price="{{ variant.price | money_without_trailing_zeros }}"
                      data-raw-price="{{ variant.price }}"
                      data-available="{{ variant.available }}"
                      data-media-id="{{ variant.featured_media.id }}"
                      {% if variant == current_variant %}selected{% endif %}
                      {% unless variant.available %}disabled{% endunless %}
                    >
                      {%- if variant.title == 'Default Title' -%}
                        {{ current_product.metafields.custom.size.value | default: 'Standard' }}
                      {%- else -%}
                        {{ variant.title }}
                      {%- endif -%}
                      {%- unless variant.available %} - Sold out{%- endunless -%}
                    </option>
                  {%- endfor -%}
                {%- else -%}
                  <option value="" data-price="{{ price_display }}" data-raw-price="{{ current_product.price | default: 0 }}" data-available="true" selected>Standard</option>
                {%- endif -%}
              </select>
              <span class="twc-select-caret" aria-hidden="true">
                <svg viewBox="0 0 12 8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M1 1.5L6 6.5L11 1.5"/>
                </svg>
              </span>
            </div>
          </div>

          <!-- Quantity Stepper Box (- 01 +) -->
          <div class="twc-field-col">
            <label class="twc-field-label">QUANTITY</label>
            <div class="twc-stepper-container">
              <button
                type="button"
                class="twc-stepper-btn twc-stepper-btn--minus"
                id="twc-qty-minus-{{ section.id }}"
                aria-label="Decrease quantity"
              >
                &minus;
              </button>
              <span class="twc-stepper-val" id="twc-qty-display-{{ section.id }}">01</span>
              <button
                type="button"
                class="twc-stepper-btn twc-stepper-btn--plus"
                id="twc-qty-plus-{{ section.id }}"
                aria-label="Increase quantity"
              >
                &#43;
              </button>
              <input
                type="hidden"
                name="quantity"
                id="twc-qty-input-{{ section.id }}"
                value="1"
              >
            </div>
          </div>
        </div>

        <!-- 8. Price Display (twc-per-gram removed) -->
        {%- if price_display != blank -%}
          <div class="twc-price-wrapper">
            <div class="twc-price-line">
              <span
                class="twc-main-price"
                id="twc-main-price-{{ section.id }}"
                data-currency-symbol="{{ cart.currency.symbol | default: 'Rs. ' }}"
              >
                {{- price_display -}}
              </span>
            </div>
            {%- if free_delivery_text != blank -%}
              <p class="twc-delivery-note">{{ free_delivery_text }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}

        <!-- 9. CTA Buttons (ADD TO CART and BUY NOW) in 400px Container -->
        <div class="twc-buttons-row">
          <!-- Add to Cart Button -->
          <button
            type="submit"
            name="add"
            class="twc-action-btn twc-action-btn--cart"
            id="twc-add-btn-{{ section.id }}"
            {% if current_variant and current_variant.available == false %}disabled style="opacity:0.5;cursor:not-allowed;"{% endif %}
          >
            <span class="twc-action-btn__text">
              {%- if current_variant and current_variant.available == false -%}
                SOLD OUT
              {%- else -%}
                ADD TO CART
              {%- endif -%}
            </span>
            <svg class="twc-action-btn__arrow" xmlns="http://www.w3.org/2000/svg" width="21" height="21" viewBox="0 0 21.0 21.0"><g><g transform="translate(-116.975,-153)"><path fill="var(--twc-p-bg, #EEE2E1)" d="m 132.975,170 c -0.274,0 -0.497,-0.221 -0.5,-0.495 -0.017,-1.674 0.626,-4.733 2.981,-6.005 -2.355,-1.271 -2.998,-4.331 -2.981,-6.005 0.003,-0.274 0.226,-0.495 0.5,-0.495 0.001,0 0.003,0 0.004,0 0.276,0.003 0.498,0.229 0.496,0.505 -0.001,0.198 0.004,4.867 3.587,5.503 0.239,0.042 0.413,0.25 0.413,0.492 0,0.242 -0.174,0.45 -0.413,0.492 -3.595,0.638 -3.588,5.453 -3.587,5.503 0.003,0.276 -0.219,0.502 -0.495,0.505 -10e-4,0 -0.003,0 -0.005,0 z"></path></g><g transform="translate(-121,-152)"><path fill="var(--twc-p-bg, #EEE2E1)" d="m 141,163 h -19 c -0.276,0 -0.5,-0.225 -0.5,-0.5 0,-0.275 0.224,-0.5 0.5,-0.5 h 19 c 0.276,0 0.5,0.225 0.5,0.5 0,0.275 -0.224,0.5 -0.5,0.5 z"></path></g></g></svg>
          </button>

          <!-- Buy Now Button -->
          <button
            type="button"
            class="twc-action-btn twc-action-btn--buynow"
            id="twc-buynow-btn-{{ section.id }}"
            {% if current_variant and current_variant.available == false %}disabled style="display:none;"{% endif %}
          >
            <span class="twc-action-btn__text">BUY NOW</span>
            <svg class="twc-action-btn__arrow" xmlns="http://www.w3.org/2000/svg" width="21" height="21" viewBox="0 0 21.0 21.0"><g><g transform="translate(-116.975,-153)"><path fill="var(--twc-p-bg, #EEE2E1)" d="m 132.975,170 c -0.274,0 -0.497,-0.221 -0.5,-0.495 -0.017,-1.674 0.626,-4.733 2.981,-6.005 -2.355,-1.271 -2.998,-4.331 -2.981,-6.005 0.003,-0.274 0.226,-0.495 0.5,-0.495 0.001,0 0.003,0 0.004,0 0.276,0.003 0.498,0.229 0.496,0.505 -0.001,0.198 0.004,4.867 3.587,5.503 0.239,0.042 0.413,0.25 0.413,0.492 0,0.242 -0.174,0.45 -0.413,0.492 -3.595,0.638 -3.588,5.453 -3.587,5.503 0.003,0.276 -0.219,0.502 -0.495,0.505 -10e-4,0 -0.003,0 -0.005,0 z"></path></g><g transform="translate(-121,-152)"><path fill="var(--twc-p-bg, #EEE2E1)" d="m 141,163 h -19 c -0.276,0 -0.5,-0.225 -0.5,-0.5 0,-0.275 0.224,-0.5 0.5,-0.5 h 19 c 0.276,0 0.5,0.225 0.5,0.5 0,0.275 -0.224,0.5 -0.5,0.5 z"></path></g></g></svg>
          </button>
        </div>

        <!-- 10. Subscribe and save link -->
        <a href="{{ subscribe_url }}" class="twc-subscribe-link" id="twc-subscribe-{{ section.id }}">{{ subscribe_text }}</a>

        <!-- 11. Bottom Meta Row (Suitable for & Pairs great with) -->
        {%- if suitable_for_text != blank or pairs_with_text != blank -%}
          <div class="twc-product__meta-footer">
            {%- if suitable_for_text != blank -%}
              <div class="twc-meta-col">
                <span class="twc-meta-label">{{ section.settings.suitable_for_label | default: "Suitable for :" }}</span>
                <span class="twc-meta-value">{{ suitable_for_text }}</span>
              </div>
            {%- endif -%}
            {%- if pairs_with_text != blank -%}
              <div class="twc-meta-col">
                <span class="twc-meta-label">{{ section.settings.pairs_with_label | default: "Pairs great with a TWC:" }}</span>
                <span class="twc-meta-value">{{ pairs_with_text }}</span>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}

        <!-- Status Message Box (Added to cart notification) -->
        <div class="twc-cart-status" id="twc-status-{{ section.id }}" role="status" aria-live="polite"></div>
      </form>
    </div>
  </div>

  <!-- Grind Guide Modal Popup -->
