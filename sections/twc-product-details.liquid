<script>
  (function () {
    var sectionId = {{ section.id | json }};
    var container = document.getElementById('twc-product-' + sectionId);
    if (!container) return;

    var galleryBox = container.querySelector('#twc-gallery-box-' + sectionId);
    var slides = container.querySelectorAll('.twc-gallery__slide');
    var dots = container.querySelectorAll('.twc-gallery__dot');
    var prevBtn = container.querySelector('#twc-prev-' + sectionId);
    var nextBtn = container.querySelector('#twc-next-' + sectionId);
    var currentIndex = 0;
    var totalSlides = slides.length;
    var isTransitioning = false;

    // Slide-in image transition with higher z-index (10)
    function goToSlide(targetIndex, direction) {
      if (totalSlides <= 1 || isTransitioning) return;
      if (targetIndex === currentIndex) return;

      if (targetIndex < 0) targetIndex = totalSlides - 1;
      if (targetIndex >= totalSlides) targetIndex = 0;

      isTransitioning = true;
      var isNext = direction !== undefined ? direction === 'next' : targetIndex > currentIndex;
      if (currentIndex === totalSlides - 1 && targetIndex === 0) isNext = true;
      if (currentIndex === 0 && targetIndex === totalSlides - 1) isNext = false;

      var currentSlide = slides[currentIndex];
      var nextSlide = slides[targetIndex];

      nextSlide.style.transition = 'none';
      nextSlide.style.zIndex = '10';
      nextSlide.style.opacity = '1';
      nextSlide.style.visibility = 'visible';
      nextSlide.style.transform = isNext ? 'translateX(100%)' : 'translateX(-100%)';
      currentSlide.style.zIndex = '2';

      nextSlide.offsetHeight;

      nextSlide.style.transition = 'transform 0.48s cubic-bezier(0.25, 1, 0.5, 1)';
      nextSlide.style.transform = 'translateX(0%)';

      dots.forEach(function (dot, idx) {
        if (idx === targetIndex) {
          dot.classList.add('is-active');
        } else {
          dot.classList.remove('is-active');
        }
      });

      setTimeout(function () {
        currentSlide.classList.remove('is-active');
        currentSlide.style.opacity = '0';
        currentSlide.style.visibility = 'hidden';
        currentSlide.style.zIndex = '1';
        currentSlide.style.transform = 'translateX(0%)';
        currentSlide.style.transition = '';

        nextSlide.classList.add('is-active');
        nextSlide.style.zIndex = '2';
        nextSlide.style.transition = '';

        currentIndex = targetIndex;
        isTransitioning = false;
      }, 500);
    }

    if (prevBtn) {
      prevBtn.addEventListener('click', function (e) {
        e.preventDefault();
        goToSlide(currentIndex - 1, 'prev');
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', function (e) {
        e.preventDefault();
        goToSlide(currentIndex + 1, 'next');
      });
    }

    dots.forEach(function (dot) {
      dot.addEventListener('click', function () {
        var idx = parseInt(this.getAttribute('data-index'), 10);
        if (!isNaN(idx)) goToSlide(idx);
      });
    });

    // Touch Swipe Gesture for Carousel
    if (galleryBox) {
      var touchStartX = 0;
      var touchEndX = 0;
      galleryBox.addEventListener('touchstart', function (e) {
        touchStartX = e.changedTouches[0].screenX;
      }, { passive: true });
      galleryBox.addEventListener('touchend', function (e) {
        touchEndX = e.changedTouches[0].screenX;
        var diff = touchStartX - touchEndX;
        if (Math.abs(diff) > 40) {
          if (diff > 0) goToSlide(currentIndex + 1, 'next');
          else goToSlide(currentIndex - 1, 'prev');
        }
      }, { passive: true });

      // Image Zoom on Hover with Cursor Tracking
      var isHovering = false;
      galleryBox.addEventListener('mouseenter', function () {
        if (window.matchMedia('(hover: hover)').matches) {
          isHovering = true;
          var activeImg = galleryBox.querySelector('.twc-gallery__slide.is-active .twc-gallery__img');
          if (activeImg) {
            activeImg.style.transition = 'transform 0.15s ease-out';
            activeImg.style.transform = 'scale(2.2)';
          }
        }
      });

      galleryBox.addEventListener('mousemove', function (e) {
        if (!isHovering) return;
        var activeImg = galleryBox.querySelector('.twc-gallery__slide.is-active .twc-gallery__img');
        if (!activeImg) return;

        var rect = galleryBox.getBoundingClientRect();
        var x = ((e.clientX - rect.left) / rect.width) * 100;
        var y = ((e.clientY - rect.top) / rect.height) * 100;
        x = Math.max(0, Math.min(100, x));
        y = Math.max(0, Math.min(100, y));

        activeImg.style.transformOrigin = x + '% ' + y + '%';
      });

      galleryBox.addEventListener('mouseleave', function () {
        isHovering = false;
        var activeImg = galleryBox.querySelector('.twc-gallery__slide.is-active .twc-gallery__img');
        if (activeImg) {
          activeImg.style.transition = 'transform 0.3s ease-out, transform-origin 0.3s ease-out';
          activeImg.style.transform = 'scale(1)';
          setTimeout(function () {
            if (!isHovering && activeImg) {
              activeImg.style.transformOrigin = 'center center';
            }
          }, 300);
        }
      });
    }

    // Dynamic Price Updates on Size or Quantity Change
    var sizeSelect = container.querySelector('#twc-size-select-' + sectionId);
    var qtyInput = container.querySelector('#twc-qty-input-' + sectionId);
    var qtyDisplay = container.querySelector('#twc-qty-display-' + sectionId);
    var qtyMinusBtn = container.querySelector('#twc-qty-minus-' + sectionId);
    var qtyPlusBtn = container.querySelector('#twc-qty-plus-' + sectionId);
    var priceDisplayEl = container.querySelector('#twc-main-price-' + sectionId);

    function updatePrice() {
      if (!priceDisplayEl) return;
      var selectedOpt = sizeSelect ? sizeSelect.options[sizeSelect.selectedIndex] : null;
      var qty = qtyInput ? (parseInt(qtyInput.value, 10) || 1) : 1;

      var rawPrice = selectedOpt ? selectedOpt.getAttribute('data-raw-price') : null;
      var priceStr = selectedOpt ? selectedOpt.getAttribute('data-price') : '';
      var currencySym = priceDisplayEl.getAttribute('data-currency-symbol') || 'Rs. ';

      if (rawPrice && !isNaN(parseFloat(rawPrice))) {
        var totalAmount = (parseFloat(rawPrice) / 100) * qty;
        priceDisplayEl.textContent = currencySym + totalAmount.toLocaleString('en-IN');
      } else if (priceStr) {
        var match = priceStr.match(/[\d,]+/);
        if (match) {
          var num = parseFloat(match[0].replace(/,/g, ''));
          var total = num * qty;
          priceDisplayEl.textContent = currencySym + total.toLocaleString('en-IN');
        } else {
          priceDisplayEl.textContent = priceStr;
        }
      }
    }

    // Quantity Stepper Logic (- 01 +)
    if (qtyMinusBtn && qtyInput && qtyDisplay) {
      qtyMinusBtn.addEventListener('click', function (e) {
        e.preventDefault();
        var currentVal = parseInt(qtyInput.value, 10) || 1;
        var newVal = Math.max(1, currentVal - 1);
        qtyInput.value = newVal;
        qtyDisplay.textContent = newVal < 10 ? '0' + newVal : '' + newVal;
        updatePrice();
      });
    }

    if (qtyPlusBtn && qtyInput && qtyDisplay) {
      qtyPlusBtn.addEventListener('click', function (e) {
        e.preventDefault();
        var currentVal = parseInt(qtyInput.value, 10) || 1;
        var newVal = currentVal + 1;
        qtyInput.value = newVal;
        qtyDisplay.textContent = newVal < 10 ? '0' + newVal : '' + newVal;
        updatePrice();
      });
    }

    // Variant Size Change Logic
    if (sizeSelect) {
      sizeSelect.addEventListener('change', function () {
        var selectedOpt = sizeSelect.options[sizeSelect.selectedIndex];
        if (!selectedOpt) return;

        updatePrice();

        // Check variant availability
        var isAvailable = selectedOpt.getAttribute('data-available') !== 'false' && !selectedOpt.disabled;
        var cartBtn = container.querySelector('#twc-add-btn-' + sectionId);
        var buyNowBtn = container.querySelector('#twc-buynow-btn-' + sectionId);
        if (cartBtn) {
          var btnText = cartBtn.querySelector('.twc-action-btn__text');
          if (btnText) btnText.textContent = isAvailable ? 'ADD TO CART' : 'SOLD OUT';
          cartBtn.disabled = !isAvailable;
          cartBtn.style.opacity = isAvailable ? '1' : '0.5';
          cartBtn.style.cursor = isAvailable ? 'pointer' : 'not-allowed';
        }
        if (buyNowBtn) {
          buyNowBtn.disabled = !isAvailable;
          buyNowBtn.style.display = isAvailable ? 'flex' : 'none';
        }

        // Switch slide if variant has associated media
        var mediaId = selectedOpt.getAttribute('data-media-id');
        if (mediaId) {
          for (var s = 0; s < slides.length; s++) {
            if (slides[s].getAttribute('data-media-id') === mediaId) {
              goToSlide(s);
              break;
            }
          }
        }
      });
    }

    // Grind Guide Modal Logic
    var guideModal = container.querySelector('#twc-guide-modal-' + sectionId);
    var openGuideBtn = container.querySelector('#twc-open-guide-' + sectionId);
    var closeGuideBtn = container.querySelector('#twc-close-guide-' + sectionId);

    function toggleGuide(open) {
      if (!guideModal) return;
      if (open) {
        guideModal.classList.add('is-open');
        document.body.style.overflow = 'hidden';
      } else {
        guideModal.classList.remove('is-open');
        document.body.style.overflow = '';
      }
    }

    if (openGuideBtn) {
      openGuideBtn.addEventListener('click', function (e) {
        e.preventDefault();
        toggleGuide(true);
      });
    }

    if (closeGuideBtn) {
      closeGuideBtn.addEventListener('click', function (e) {
        e.preventDefault();
        toggleGuide(false);
      });
    }

    if (guideModal) {
      guideModal.addEventListener('click', function (e) {
        if (e.target === guideModal) toggleGuide(false);
      });
    }

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && guideModal && guideModal.classList.contains('is-open')) {
        toggleGuide(false);
      }
    });

    // Cart Drawer / Cart AJAX Integration
    var form = container.querySelector('#twc-product-form-' + sectionId);
    var cartBtn = container.querySelector('#twc-add-btn-' + sectionId);
    var buyNowBtn = container.querySelector('#twc-buynow-btn-' + sectionId);
    var statusEl = container.querySelector('#twc-status-' + sectionId);

    function showStatus(msg, isError) {
      if (!statusEl) return;
      statusEl.textContent = msg;
      statusEl.style.display = 'block';
      statusEl.style.backgroundColor = isError ? '#f8d7da' : '#d4edda';
      statusEl.style.color = isError ? '#721c24' : '#155724';
      statusEl.style.borderColor = isError ? '#f5c6cb' : '#c3e6cb';
      setTimeout(function () {
        statusEl.style.display = 'none';
      }, 4000);
    }

    function triggerCartDrawer() {
      var drawerTrigger = document.querySelector('.twc-cart-trigger');
      if (drawerTrigger) {
        drawerTrigger.click();
      } else {
        var cartDrawer = document.getElementById('cart-drawer');
        if (cartDrawer) {
          if (typeof cartDrawer.show === 'function') cartDrawer.show();
          else cartDrawer.toggleAttribute('open');
        }
      }
    }

    if (form) {
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var formData = new FormData(form);
        if (cartBtn) cartBtn.classList.add('is-loading');

        fetch((window.Shopify?.routes?.root || '/') + 'cart/add.js', {
          method: 'POST',
          body: formData,
          headers: {
            'X-Requested-With': 'XMLHttpRequest'
          }
        })
          .then(function (res) {
            return res.json();
          })
          .then(function (data) {
            if (cartBtn) cartBtn.classList.remove('is-loading');
            if (data.status && data.status >= 400) {
              showStatus(data.description || 'Could not add to cart.', true);
            } else {
              showStatus('Added to cart successfully!', false);
              document.dispatchEvent(new CustomEvent('cart:updated', { bubbles: true }));
              document.dispatchEvent(new CustomEvent('shopify:cart:lines-update', { bubbles: true }));
              triggerCartDrawer();
            }
          })
          .catch(function () {
            if (cartBtn) cartBtn.classList.remove('is-loading');
            showStatus('Added to cart!', false);
            triggerCartDrawer();
          });
      });
    }

    // Buy Now Direct Checkout Logic
    if (buyNowBtn && form) {
      buyNowBtn.addEventListener('click', function (e) {
        e.preventDefault();
        var formData = new FormData(form);
        buyNowBtn.classList.add('is-loading');

        fetch((window.Shopify?.routes?.root || '/') + 'cart/add.js', {
          method: 'POST',
          body: formData,
          headers: {
            'X-Requested-With': 'XMLHttpRequest'
          }
        })
          .then(function () {
            window.location.href = (window.Shopify?.routes?.root || '/') + 'checkout';
          })
          .catch(function () {
            window.location.href = (window.Shopify?.routes?.root || '/') + 'checkout';
          });
      });
    }
  })();
</script>

