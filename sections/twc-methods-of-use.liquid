<section class="twc-methods-section twc-methods-{{ section.id }}" id="twc-methods-{{ section.id }}">
  <div class="twc-methods-container">

    {%- if section.settings.show_value_props -%}
      <!-- 4-COLUMN VALUE PROPOSITIONS GRID -->
      <div class="twc-value-props-grid" aria-label="Our Commitments">
        {%- for block in section.blocks -%}
          {%- if block.type == 'value_prop' -%}
            <article class="twc-prop-card" {{ block.shopify_attributes }}>
              <div class="twc-prop-icon-wrapper">
                {%- if block.settings.custom_svg != blank -%}
                  {{ block.settings.custom_svg }}
                {%- elsif block.settings.icon_image != blank -%}
                  <img
                    src="{{ block.settings.icon_image | image_url: width: 100 }}"
                    alt="{{ block.settings.title | escape }}"
                    class="twc-prop-icon-img"
                    width="48"
                    height="48"
                    loading="lazy"
                  >
                {%- else -%}
                  {%- case block.settings.preset_icon -%}
                    {%- when 'sourced' -%}
                      <svg class="twc-prop-icon" viewBox="0 0 64 64">
                        <path d="M12 40c4-2 10-2 15 2l8 6c4 3 9 4 15 2l6-2" />
                        <path d="M12 40c-2 2-2 5 0 7 4 4 10 5 16 3l12-5" />
                        <ellipse cx="36" cy="21" rx="8" ry="12" transform="rotate(25 36 21)" fill="currentColor" stroke="currentColor" />
                        <path d="M33 11c3 6 4 14 0 20" stroke="#ffffff" stroke-width="1.6" />
                      </svg>
                    {%- when 'roasted' -%}
                      <svg class="twc-prop-icon" viewBox="0 0 64 64">
                        <ellipse cx="26" cy="36" rx="9" ry="13" transform="rotate(-15 26 36)" fill="currentColor" stroke="currentColor" />
                        <path d="M25 25c2 6 2 15-2 21" stroke="#ffffff" stroke-width="1.6" />
                        <path d="M35 15c2 2 2 5 0 7" />
                        <path d="M40 12c3 3 3 8 0 11" />
                        <circle cx="20" cy="22" r="9" fill="#ffffff" stroke="currentColor" stroke-width="1.8" />
                        <polyline points="20 17 20 22 24 24" stroke="currentColor" stroke-width="1.8" />
                      </svg>
                    {%- when 'sealed' -%}
                      <svg class="twc-prop-icon" viewBox="0 0 64 64">
                        <rect x="15" y="24" width="34" height="26" rx="2" stroke="currentColor" stroke-width="1.8" />
                        <line x1="15" y1="31" x2="49" y2="31" stroke="currentColor" stroke-width="1.5" />
                        <path d="M32 24c-4-8-12-8-11-1 1 5 11 1 11 1" />
                        <path d="M32 24c4-8 12-8 11-1-1 5-11 1-11 1" />
                        <ellipse cx="32" cy="40" rx="4.5" ry="6.5" fill="currentColor" stroke="currentColor" />
                        <path d="M32 35c1 3 1 7-1 10" stroke="#ffffff" stroke-width="1.2" />
                      </svg>
                    {%- when 'delivered' -%}
                      <svg class="twc-prop-icon" viewBox="0 0 64 64">
                        <path d="M12 24h24v18h-24z" stroke="currentColor" stroke-width="1.8" />
                        <path d="M36 27h10l5 7v8h-15z" stroke="currentColor" stroke-width="1.8" />
                        <circle cx="21" cy="43" r="4.5" fill="#ffffff" stroke="currentColor" stroke-width="1.8" />
                        <circle cx="44" cy="43" r="4.5" fill="#ffffff" stroke="currentColor" stroke-width="1.8" />
                        <ellipse cx="24" cy="33" rx="3.5" ry="5" fill="currentColor" stroke="currentColor" />
                        <path d="M24 29c1 2 1 6-1 8" stroke="#ffffff" stroke-width="1" />
                        <path d="M27 16c2 2 1 5 0 7" />
                        <path d="M32 14c2 3 1 6-1 8" />
                      </svg>
                  {%- endcase -%}
                {%- endif -%}
              </div>
              {%- if block.settings.title != blank -%}
                <h3 class="twc-prop-title">{{ block.settings.title }}</h3>
              {%- endif -%}
              <div class="twc-prop-divider"></div>
              {%- if block.settings.caption != blank -%}
                <p class="twc-prop-caption">{{ block.settings.caption }}</p>
              {%- endif -%}
            </article>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    <!-- BREWING METHODS (FLEX: 25% CONTENT / 65% DESKTOP IMAGE) -->
    <div class="twc-brewing-section" aria-label="Brewing Guides and Methods">
      
      <!-- Left Column: Accordion (25% width on desktop) -->
      <div class="twc-brewing-content">
        {%- if section.settings.heading != blank -%}
          <h2 class="twc-section-headline">{{ section.settings.heading }}</h2>
        {%- endif -%}

        <div class="twc-accordion-list" role="region" aria-label="Brewing Method Details">
          {%- assign method_index = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'brewing_method' -%}
              {%- assign method_index = method_index | plus: 1 -%}
              <div class="twc-accordion-item {% if method_index == 1 %}active{% endif %}" data-target="twc-method-img-{{ block.id }}" {{ block.shopify_attributes }}>
                <button class="twc-accordion-header" aria-expanded="{% if method_index == 1 %}true{% else %}false{% endif %}" type="button">
                  <span class="twc-method-name">{{ block.settings.title }}</span>
                  <svg class="twc-chevron-icon" viewBox="0 0 24 24">
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                </button>
                <div class="twc-accordion-body">
                  <div class="twc-accordion-inner">
                    <div class="twc-method-details">
                      {%- if block.settings.time != blank -%}
                        <p class="twc-method-time"><strong>Total time:</strong> {{ block.settings.time }}</p>
                      {%- endif -%}
                      {%- if block.settings.description != blank -%}
                        <div class="twc-method-desc">
                          {{ block.settings.description }}
                        </div>
                      {%- endif -%}
                      {%- if block.settings.link_label != blank and block.settings.link_url != blank -%}
                        <div class="twc-learn-more-wrapper">
                          <a href="{{ block.settings.link_url }}" class="twc-learn-more-link">{{ block.settings.link_label }}</a>
                        </div>
                      {%- endif -%}

                      <!-- Mobile Accordion Inline Image -->
                      <div class="twc-mobile-method-image">
                        {%- if block.settings.image != blank -%}
                          <img
                            src="{{ block.settings.image | image_url: width: 800 }}"
                            alt="{{ block.settings.image.alt | default: block.settings.title | escape }}"
                            loading="lazy"
                            width="{{ block.settings.image.width }}"
                            height="{{ block.settings.image.height }}"
                          >
                        {%- elsif block.settings.fallback_image_url != blank -%}
                          <img
                            src="{{ block.settings.fallback_image_url }}"
                            alt="{{ block.settings.title | escape }}"
                            loading="lazy"
                          >
                        {%- endif -%}
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>

        <!-- Action Button (Add to cart styling) -->
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_url | default: '#' }}" class="twc-download-btn">
            <span class="twc-download-btn__text">{{ section.settings.button_label }}</span>
            <svg class="twc-download-btn__arrow" xmlns="http://www.w3.org/2000/svg" width="21" height="21" viewBox="0 0 21.0 21.0">
              <g>
                <g transform="translate(-116.975,-153)">
                  <path fill="currentColor" d="m 132.975,170 c -0.274,0 -0.497,-0.221 -0.5,-0.495 -0.017,-1.674 0.626,-4.733 2.981,-6.005 -2.355,-1.271 -2.998,-4.331 -2.981,-6.005 0.003,-0.274 0.226,-0.495 0.5,-0.495 0.001,0 0.003,0 0.004,0 0.276,0.003 0.498,0.229 0.496,0.505 -0.001,0.198 0.004,4.867 3.587,5.503 0.239,0.042 0.413,0.25 0.413,0.492 0,0.242 -0.174,0.45 -0.413,0.492 -3.595,0.638 -3.588,5.453 -3.587,5.503 0.003,0.276 -0.219,0.502 -0.495,0.505 -10e-4,0 -0.003,0 -0.005,0 z"></path>
                </g>
                <g transform="translate(-121,-152)">
                  <path fill="currentColor" d="m 141,163 h -19 c -0.276,0 -0.5,-0.225 -0.5,-0.5 0,-0.275 0.224,-0.5 0.5,-0.5 h 19 c 0.276,0 0.5,0.225 0.5,0.5 0,0.275 -0.224,0.5 -0.5,0.5 z"></path>
                </g>
              </g>
            </svg>
          </a>
        {%- endif -%}
      </div>

      <!-- Right Column: Visual Stage (Desktop Image: ~65% width) -->
      <div class="twc-brewing-visual-wrapper">
        {%- assign img_index = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'brewing_method' -%}
            {%- assign img_index = img_index | plus: 1 -%}
            {%- if block.settings.image != blank -%}
              <img
                id="twc-method-img-{{ block.id }}"
                class="twc-brewing-image {% if img_index == 1 %}active{% endif %}"
                src="{{ block.settings.image | image_url: width: 1200 }}"
                alt="{{ block.settings.image.alt | default: block.settings.title | escape }}"
                loading="{% if img_index == 1 %}eager{% else %}lazy{% endif %}"
                width="{{ block.settings.image.width }}"
                height="{{ block.settings.image.height }}"
              >
            {%- elsif block.settings.fallback_image_url != blank -%}
              <img
                id="twc-method-img-{{ block.id }}"
                class="twc-brewing-image {% if img_index == 1 %}active{% endif %}"
                src="{{ block.settings.fallback_image_url }}"
                alt="{{ block.settings.title | escape }}"
                loading="{% if img_index == 1 %}eager{% else %}lazy{% endif %}"
              >
            {%- else -%}
              <div id="twc-method-img-{{ block.id }}" class="twc-brewing-image twc-brewing-image-placeholder {% if img_index == 1 %}active{% endif %}">
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              </div>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </div>

    </div>

  </div>
</section>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,300;0,400;0,700;0,900;1,400;1,700&family=Montserrat:wght@400;500;600;700&display=swap');

  /* ==========================================================================
     THIRD WAVE COFFEE - METHODS OF USE SECTION STYLES
     ========================================================================== */
  .twc-methods-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#FBFAF9' }};
    color: {{ section.settings.text_color | default: '#1a2634' }};
    font-family: 'Lato', sans-serif;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    box-sizing: border-box;
    width: 100%;
    position: relative;
  }

  .twc-methods-{{ section.id }} *,
  .twc-methods-{{ section.id }} *::before,
  .twc-methods-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  /* 1. Main container: Matches .twc-product-container width and padding */
  .twc-methods-{{ section.id }} .twc-methods-container {
    max-width: 1440px;
    margin: 0 auto;
    padding: 100px 40px 80px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: {{ section.settings.section_gap | default: 64 }}px;
    width: 100%;
    box-sizing: border-box;
  }

  /* TOP: 4-COLUMN VALUE PROPOSITIONS GRID */
  .twc-methods-{{ section.id }} .twc-value-props-grid {
    display: flex;
    justify-content: space-between;
    gap: 32px;
    width: 100%;
  }

  .twc-methods-{{ section.id }} .twc-prop-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    flex: 1 1 0;
    min-width: 0;
  }

  .twc-methods-{{ section.id }} .twc-prop-icon-wrapper {
    height: 56px;
    display: flex;
    align-items: flex-end;
    margin-bottom: 16px;
    color: {{ section.settings.accent_color | default: '#2D3C4B' }};
  }

  .twc-methods-{{ section.id }} .twc-prop-icon {
    width: 48px;
    height: 48px;
    stroke: currentColor;
    fill: none;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .twc-methods-{{ section.id }} .twc-prop-icon-wrapper svg {
    display: block;
    max-width: 48px;
    max-height: 48px;
  }

  .twc-methods-{{ section.id }} .twc-prop-icon-img {
    width: 75px;
    height: 75px;
    object-fit: contain;
  }

  .twc-methods-{{ section.id }} .twc-prop-title {
    font-family: 'Lato', sans-serif;
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: {{ section.settings.accent_color | default: '#2D3C4B' }};
    margin: 0 0 10px 0;
  }

  .twc-methods-{{ section.id }} .twc-prop-divider {
    width: 100%;
    height: 1.5px;
    background-color: {{ section.settings.divider_color | default: '#2D3C4B' }};
    margin-bottom: 12px;
  }

  /* 2. Caption font style: "Angsana New", serif */
  .twc-methods-{{ section.id }} .twc-prop-caption {
    font-family: "Angsana New", serif;
    font-size: 17px;
    color: #606B76;
    line-height: 1.4;
    margin: 0;
  }

  /* 3. Brewing Methods: Left container width 25%, Space Between */
  .twc-methods-{{ section.id }} .twc-brewing-section {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    width: 100%;
  }

  .twc-methods-{{ section.id }} .twc-brewing-content {
    display: flex;
    flex-direction: column;
    flex: 0 0 24%;
    width: 24%;
    max-width: 24%;
  }

  /* Section Title Styled Like Product Details Page Title */
  .twc-methods-{{ section.id }} .twc-section-headline {
    font-family: 'Lato', sans-serif;
    font-size: 25px;
    line-height: 1.25;
    font-weight: 800;
    text-transform: uppercase;
    color: {{ section.settings.accent_color | default: '#2D3C4B' }};
    letter-spacing: 0.02em;
    margin: 0 0 24px 0;
  }

  .twc-methods-{{ section.id }} .twc-accordion-list {
    display: flex;
    flex-direction: column;
    margin-bottom: 28px;
    row-gap: 30px;
  }

  .twc-methods-{{ section.id }} .twc-accordion-item {
    border-bottom: 1px solid {{ section.settings.divider_color | default: '#2D3C4B' }};
  }

  /* 6. Remove space-between and add 20px gap */
  .twc-methods-{{ section.id }} .twc-accordion-header {
    width: 100%;
    background: none;
    border: none;
    outline: none;
    padding: 16px 0;
    display: flex;
    justify-content: flex-start;
    align-items: center;
    gap: 20px;
    cursor: pointer;
    text-align: left;
    transition: opacity 0.2s ease;
  }

  .twc-methods-{{ section.id }} .twc-accordion-header:hover {
    opacity: 0.8;
  }

  .twc-methods-{{ section.id }} .twc-method-name {
    font-family: 'Lato', sans-serif;
    font-size: 15px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: {{ section.settings.accent_color | default: '#2D3C4B' }};
  }

  .twc-methods-{{ section.id }} .twc-chevron-icon {
    width: 14px;
    height: 14px;
    stroke: {{ section.settings.accent_color | default: '#2D3C4B' }};
    fill: none;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    flex-shrink: 0;
  }

  /* Smooth Height Transition with CSS Grid */
  .twc-methods-{{ section.id }} .twc-accordion-body {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .twc-methods-{{ section.id }} .twc-accordion-inner {
    overflow: hidden;
  }

  .twc-methods-{{ section.id }} .twc-accordion-item.active .twc-accordion-body {
    grid-template-rows: 1fr;
  }

  .twc-methods-{{ section.id }} .twc-accordion-item.active .twc-chevron-icon {
    transform: rotate(180deg);
  }

  .twc-methods-{{ section.id }} .twc-method-details {
    padding: 0 0 20px 0;
  }

  .twc-methods-{{ section.id }} .twc-accordion-item.active .twc-method-details {
    padding-top: 20px;
  }

  .twc-methods-{{ section.id }} .twc-method-time {
    font-family: "Angsana New", serif;
    font-size: 17px;
    color: #2D3C4B;
    margin: 0 0 8px 0;
    line-height: 1.35;
  }

  .twc-methods-{{ section.id }} .twc-method-time strong {
    font-weight: 600;
  }

  /* 5. twc-method-desc font style exactly like small_description (Angsana New, 15px, line-height 1.3, #25394A) */
  .twc-methods-{{ section.id }} .twc-method-desc {
    font-family: "Angsana New", serif;
    font-size: 15px;
    line-height: 1.3;
    color: #25394A;
    font-weight: 500;
    margin-bottom: 8px;
  }

  .twc-methods-{{ section.id }} .twc-method-desc p {
    font-family: inherit;
    font-size: inherit;
    line-height: inherit;
    color: inherit;
    font-weight: inherit;
    margin: 0 0 6px 0;
    display: inline;
  }

  /* 1. Learn more on next line below caption, font-weight 600 with underline */
  .twc-methods-{{ section.id }} .twc-learn-more-wrapper {
    margin-top: 4px;
    margin-bottom: 4px;
  }

  .twc-methods-{{ section.id }} .twc-learn-more-link {
    display: inline-block;
    font-family: "Angsana New", serif;
    font-size: 15px;
    font-weight: 600;
    color: {{ section.settings.accent_color | default: '#2D3C4B' }};
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: opacity 0.2s ease;
  }

  .twc-methods-{{ section.id }} .twc-learn-more-link:hover {
    opacity: 0.7;
  }

  /* Mobile Inline Image inside Accordion */
  .twc-methods-{{ section.id }} .twc-mobile-method-image {
    display: none;
    margin-top: 14px;
    width: 100%;
    border-radius: 4px;
    overflow: hidden;
  }

  .twc-methods-{{ section.id }} .twc-mobile-method-image img {
    width: 100%;
    height: auto;
    max-height: 320px;
    object-fit: cover;
    display: block;
  }

  /* 4. Download CTA like Add To Cart style: height 40px, border-radius 0px 18px, Lato 10px uppercase, arrow */
  .twc-methods-{{ section.id }} .twc-download-btn {
    height: 40px;
    width: 100%;
    background-color: var(--twc-p-btn-bg, #2D3C4B);
    color: var(--twc-p-bg, #EEE2E1);
    border: none;
    border-radius: 0px 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    cursor: pointer;
    font-family: 'Lato', sans-serif;
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: background-color 0.25s ease, transform 0.15s ease;
    box-sizing: border-box;
    padding: 0 16px;
    text-decoration: none;
    margin-top: 10px;
  }

  .twc-methods-{{ section.id }} .twc-download-btn:hover {
    background-color: #1e2832;
  }

  .twc-methods-{{ section.id }} .twc-download-btn:active {
    transform: scale(0.985);
  }

  .twc-methods-{{ section.id }} .twc-download-btn__text {
    flex: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .twc-methods-{{ section.id }} .twc-download-btn__arrow {
    width: 21px;
    height: 21px;
    transition: transform 0.2s ease;
    flex-shrink: 0;
    color: var(--twc-p-bg, #EEE2E1);
  }

  .twc-methods-{{ section.id }} .twc-download-btn:hover .twc-download-btn__arrow {
    transform: translateX(4px);
  }

  /* Active accordion: show line below header/title, remove line below content/learn more */
  .twc-methods-{{ section.id }} .twc-accordion-item.active {
    border-bottom: none;
  }

  .twc-methods-{{ section.id }} .twc-accordion-item.active .twc-accordion-header {
    border-bottom: 1px solid {{ section.settings.divider_color | default: '#2D3C4B' }};
  }

  /* 3. Right Column: Visual Stage (Desktop Image: reduced height from 520px to 380px, width unchanged) */
  .twc-methods-{{ section.id }} .twc-brewing-visual-wrapper {
    position: sticky;
    top: 40px;
    flex: 0 0 60%;
    width: 60%;
    max-width: 60%;
    height: 450px;
    border-radius: 4px;
    overflow: hidden;
    background-color: #f7f7f7;
  }

  .twc-methods-{{ section.id }} .twc-brewing-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0;
    transform: scale(1.02);
    transition: opacity 0.5s ease, transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
    pointer-events: none;
  }

  .twc-methods-{{ section.id }} .twc-brewing-image.active {
    opacity: 1;
    transform: scale(1);
    pointer-events: auto;
  }

  .twc-methods-{{ section.id }} .twc-brewing-image-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: #eef2f5;
  }

  .twc-methods-{{ section.id }} .twc-brewing-image-placeholder svg {
    width: 80px;
    height: 80px;
    opacity: 0.4;
  }

  /* ==========================================================================
     481px — 768px: iPads, Tablets Responsive
     ========================================================================== */
  @media only screen and (min-width: 481px) and (max-width: 768px) {
    /* 5. 50px padding top and bottom */
    .twc-methods-{{ section.id }} .twc-methods-container {
      padding: 50px 24px;
      gap: 36px;
    }

    .twc-methods-{{ section.id }} .twc-value-props-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 28px 20px;
    }

    /* 4. Scaled font sizes proportionally */
    .twc-methods-{{ section.id }} .twc-prop-icon-img {
      width: 58px;
      height: 58px;
    }

    .twc-methods-{{ section.id }} .twc-prop-title {
      font-size: 13px;
    }

    .twc-methods-{{ section.id }} .twc-prop-caption {
      font-size: 15px;
    }

    .twc-methods-{{ section.id }} .twc-brewing-section {
      flex-direction: column;
    }

