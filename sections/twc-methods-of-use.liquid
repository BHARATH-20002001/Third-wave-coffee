<script>
  (function() {
    function initMethodsOfUse() {
      const sectionElem = document.getElementById('twc-methods-{{ section.id }}');
      if (!sectionElem) return;

      const accordionItems = sectionElem.querySelectorAll('.twc-accordion-item');
      const methodImages = sectionElem.querySelectorAll('.twc-brewing-image');

      accordionItems.forEach(item => {
        const header = item.querySelector('.twc-accordion-header');
        if (!header) return;

        header.addEventListener('click', () => {
          const isCurrentlyActive = item.classList.contains('active');
          if (isCurrentlyActive) return;

          // 1. Reset all accordion items in this section
          accordionItems.forEach(otherItem => {
            otherItem.classList.remove('active');
            const otherHeader = otherItem.querySelector('.twc-accordion-header');
            if (otherHeader) otherHeader.setAttribute('aria-expanded', 'false');
          });

          // 2. Activate clicked item
          item.classList.add('active');
          header.setAttribute('aria-expanded', 'true');

          // 3. Switch image with crossfade (desktop right column)
          const targetImageId = item.getAttribute('data-target');
          methodImages.forEach(img => {
            if (img.id === targetImageId) {
              img.classList.add('active');
            } else {
              img.classList.remove('active');
            }
          });
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initMethodsOfUse);
    } else {
      initMethodsOfUse();
    }

    // Support Shopify Theme Editor dynamic events
    document.addEventListener('shopify:section:load', function(event) {
      if (event.detail && event.detail.sectionId === '{{ section.id }}') {
        initMethodsOfUse();
      }
    });

    document.addEventListener('shopify:block:select', function(event) {
      if (event.detail && event.detail.sectionId === '{{ section.id }}') {
        const blockId = event.detail.blockId;
        const targetItem = document.querySelector(`.twc-accordion-item[data-target="twc-method-img-${blockId}"]`);
        if (targetItem) {
          const header = targetItem.querySelector('.twc-accordion-header');
          if (header) header.click();
        }
      }
    });
  })();
</script>

