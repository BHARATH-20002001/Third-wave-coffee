{%- doc -%}
  Third Wave Coffee - Custom Related Products Section
  - Heading: "YOU MAY ALSO LIKE"
  - Dynamic product loop with intelligent fallback:
      1. Shopify Recommendations API (recommendations.products)
      2. Merchant selected Product List (if configured)
      3. Custom Collection (if configured)
      4. Current Product's primary Collection (excluding current product)
      5. Store catalog (collections.all.products, excluding current product)
      6. Curated Third Wave Coffee demo items matching design mockup
  - 4-column responsive grid (4 on desktop, 2 on tablet/mobile)
  - 1:1 Aspect ratio square image cards with rotating pastel/tinted studio backgrounds
  - Product Title (uppercase, bold Lato)
  - Subtitle / Roast Level (italic Merriweather)
  - Flavor Notes (italic Merriweather)
  - Pill Action Button ("ADD TO CART   Rs 400") with AJAX cart add & cart drawer trigger
{%- enddoc -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,300;0,400;0,700;0,800;0,900;1,400;1,700&family=Merriweather:ital,wght@0,300;0,400;0,700;1,300;1,400&display=swap" rel="stylesheet">

{%- liquid
  assign current_prod = product | default: closest.product
  assign current_prod_id = current_prod.id
  assign max_items = section.settings.products_to_show | default: 4

  assign heading = section.settings.heading | default: 'YOU MAY ALSO LIKE'
  assign bg_color = section.settings.bg_color | default: '#FBFAF9'
  assign heading_color = section.settings.heading_color | default: '#24394a'
  assign btn_bg = section.settings.btn_bg_color | default: '#D7D1C9'
  assign btn_text = section.settings.btn_text_color | default: '#2D3C4B'
  assign btn_hover_bg = section.settings.btn_hover_bg_color | default: '#c5beb6'
  assign btn_hover_text = section.settings.btn_hover_text_color | default: '#2D3C4B'

  # Rotating studio background tints matching mockup
  assign tint_1 = '#c5b9b4'
  assign tint_2 = '#d8c8b4'
  assign tint_3 = '#bfb3b4'
  assign tint_4 = '#ddb7b7'

  # Build candidate products list
  assign candidate_products = empty

  if section.settings.use_exact_mockup_cards
    assign candidate_products = empty
  elsif section.settings.product_list != blank and section.settings.product_list.count > 0
    assign candidate_products = section.settings.product_list
  elsif section.settings.collection != blank and section.settings.collection.products_count > 0
    assign candidate_products = section.settings.collection.products
  elsif recommendations.performed and recommendations.products_count > 0
    assign candidate_products = recommendations.products
  elsif current_prod.collections.size > 0
    for coll in current_prod.collections
      if coll.products_count > 1
        assign candidate_products = coll.products
        break
      endif
    endfor
    if candidate_products == empty
      assign candidate_products = current_prod.collections.first.products
    endif
  elsif collections.all.products_count > 0
    assign candidate_products = collections.all.products
  endif

  # First available store variant for demo fallback add-to-cart
  assign first_store_variant_id = collections.all.products.first.first_available_variant.id
-%}

<div
  class="twc-related-products twc-rp-{{ section.id }}"
  id="twc-rp-{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-product-id="{{ current_prod_id }}"
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ current_prod_id }}&limit={{ max_items }}"
>
  <div class="twc-related-products__inner">
    {%- if heading != blank -%}
      <h2 class="twc-related-products__heading">{{ heading }}</h2>
    {%- endif -%}

    <div class="twc-related-products__grid" id="twc-rp-grid-{{ section.id }}">
      {%- assign rendered_count = 0 -%}
      {%- assign displayed_ids = current_prod_id | append: ',' -%}

      {%- # 1. Render dynamic catalog / recommended products -%}
      {%- if candidate_products != empty -%}
        {%- for prod in candidate_products -%}
          {%- if rendered_count >= max_items -%}
            {%- break -%}
          {%- endif -%}

          {%- assign prod_id_str = prod.id | append: '' -%}
          {%- if displayed_ids contains prod_id_str -%}
            {%- continue -%}
          {%- endif -%}

          {%- assign displayed_ids = displayed_ids | append: prod_id_str | append: ',' -%}
          {%- assign rendered_count = rendered_count | plus: 1 -%}

          {%- # Resolve product image -%}
          {%- assign prod_image = prod.featured_image -%}
          {%- if prod_image == blank and prod.images.size > 0 -%}
            {%- assign prod_image = prod.images.first -%}
          {%- endif -%}

          {%- assign fallback_asset = 'twc-related-product-' | append: rendered_count | append: '.png' -%}

          {%- # Subtitle / Roast Level -%}
          {%- assign card_subtitle = prod.metafields.descriptors.subtitle.value | default: prod.metafields.descriptors.subtitle -%}
          {%- if card_subtitle == blank -%}
            {%- assign card_subtitle = prod.metafields.custom.roast_type.value | default: prod.metafields.custom.roast_type -%}
          {%- endif -%}
          {%- if card_subtitle == blank -%}
            {%- assign card_subtitle = prod.metafields.custom.roast_level.value | default: prod.metafields.custom.roast_level -%}
            {%- if card_subtitle != blank -%}
              {%- assign card_subtitle = 'Roast Level ' | append: card_subtitle -%}
            {%- endif -%}
          {%- endif -%}
          {%- if card_subtitle == blank -%}
            {%- assign card_subtitle = section.settings.default_roast_label | default: 'Roast Level' -%}
          {%- endif -%}

          {%- # Flavor Notes / Description -%}
          {%- assign card_notes = prod.metafields.custom.flavor_notes.value | default: prod.metafields.custom.flavor_notes -%}
          {%- if card_notes == blank -%}
            {%- assign card_notes = prod.metafields.custom.short_description.value | default: prod.metafields.custom.short_description -%}
          {%- endif -%}
          {%- if card_notes == blank and prod.description != blank -%}
            {%- assign card_notes = prod.description | strip_html | strip -%}
          {%- endif -%}
          {%- if card_notes == blank -%}
            {%- assign card_notes = section.settings.default_flavor_notes | default: 'Dark Chocolate Macadamia Nuts, Brown Sugar, Mandarin, Roasted Almond Pistachio' -%}
          {%- endif -%}

          {%- # Price -%}
          {%- assign card_variant = prod.selected_or_first_available_variant -%}
          {%- if card_variant and card_variant.price > 0 -%}
            {%- assign card_price = card_variant.price | money_without_trailing_zeros -%}
          {%- elsif prod.price and prod.price > 0 -%}
            {%- assign card_price = prod.price | money_without_trailing_zeros -%}
          {%- else -%}
            {%- assign card_price = 'Rs 400' -%}
          {%- endif -%}

          {%- if card_price contains 'Rs.' -%}
            {%- assign card_price = card_price | replace: 'Rs.', 'Rs' -%}
          {%- endif -%}

          <div class="twc-rp-card" data-product-id="{{ prod.id }}">
            <a href="{{ prod.url }}" class="twc-rp-card__image-link" aria-label="{{ prod.title | escape }}">
              <div
                class="twc-rp-card__image-wrap"
                style="background-color: {% cycle 'tint_cycle': tint_1, tint_2, tint_3, tint_4 %};"
              >
                {%- if prod_image != blank -%}
                  <img
                    src="{{ prod_image | image_url: width: 600 }}"
                    alt="{{ prod.title | escape }}"
                    loading="lazy"
                    width="400"
                    height="400"
                    class="twc-rp-card__img"
                  >
                {%- else -%}
                  <img
                    src="{{ fallback_asset | asset_url }}"
                    alt="{{ prod.title | escape }}"
                    loading="lazy"
                    width="400"
                    height="400"
                    class="twc-rp-card__img"
                    onerror="this.src='{{ 'twc-vienna-roast-1.jpg' | asset_url }}';"
                  >
                {%- endif -%}
              </div>
            </a>

            <div class="twc-rp-card__content">
              <h3 class="twc-rp-card__title">
                <a href="{{ prod.url }}">{{ prod.title | upcase }}</a>
              </h3>

              {%- if card_subtitle != blank -%}
                <div class="twc-rp-card__subtitle">{{ card_subtitle }}</div>
              {%- endif -%}

              {%- if card_notes != blank -%}
                <div class="twc-rp-card__notes">{{ card_notes }}</div>
              {%- endif -%}

              <div class="twc-rp-card__footer">
                <button
                  type="button"
                  class="twc-rp-card__btn{% unless prod.available %} is-disabled{% endunless %}"
                  data-variant-id="{{ card_variant.id }}"
                  data-product-url="{{ prod.url }}"
                  {% unless prod.available %}disabled{% endunless %}
                  aria-label="Add {{ prod.title | escape }} to cart"
                >
                  <span class="twc-rp-card__btn-label">
                    {%- if prod.available -%}
                      ADD TO CART
                    {%- else -%}
                      SOLD OUT
                    {%- endif -%}
                  </span>
                  <span class="twc-rp-card__btn-price">{{ card_price }}</span>
                </button>
              </div>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}

      {%- # 2. Curated Fallback Demo Cards to guarantee exactly 4 cards matching mockup -%}
      {%- if rendered_count < max_items -%}
        {%- assign needed = max_items | minus: rendered_count -%}
        {%- for i in (1..needed) -%}
          {%- assign slot = rendered_count | plus: i -%}
          {%- case slot -%}
            {%- when 1 -%}
              {%- assign demo_title = 'SIGNATURE COLD BREW BLEND' -%}
              {%- assign demo_subtitle = 'Roast Level' -%}
              {%- assign demo_notes = 'Dark Chocolate Macadamia Nuts, Brown Sugar, Mandarin, Roasted Almond Pistachio' -%}
              {%- assign demo_price = 'Rs 400' -%}
              {%- assign demo_bg = tint_1 -%}
              {%- assign demo_img = 'twc-related-product-1.png' -%}
            {%- when 2 -%}
              {%- assign demo_title = 'SIGNATURE FILTER COFFEE' -%}
              {%- assign demo_subtitle = 'Roast Level' -%}
              {%- assign demo_notes = 'Dark Chocolate Macadamia Nuts, Brown Sugar' -%}
              {%- assign demo_price = 'Rs 400' -%}
              {%- assign demo_bg = tint_2 -%}
              {%- assign demo_img = 'twc-related-product-2.png' -%}
            {%- when 3 -%}
              {%- assign demo_title = 'SIGNATURE COLD BREW BLEND' -%}
              {%- assign demo_subtitle = 'Roast Level' -%}
              {%- assign demo_notes = 'Dark Chocolate Macadamia Nuts, Brown Sugar' -%}
              {%- assign demo_price = 'Rs 400' -%}
              {%- assign demo_bg = tint_3 -%}
              {%- assign demo_img = 'twc-related-product-3.png' -%}
            {%- else -%}
              {%- assign demo_title = 'SIGNATURE COLD BREW BLEND' -%}
              {%- assign demo_subtitle = 'Roast Level' -%}
              {%- assign demo_notes = 'Dark Chocolate Macadamia Nuts, Brown Sugar, Mandarin, Roasted Almond Pistachio' -%}
              {%- assign demo_price = 'Rs 400' -%}
              {%- assign demo_bg = tint_4 -%}
              {%- assign demo_img = 'twc-related-product-4.png' -%}
          {%- endcase -%}

          <div class="twc-rp-card is-demo-card">
            <a href="/collections/all" class="twc-rp-card__image-link" aria-label="{{ demo_title }}">
              <div class="twc-rp-card__image-wrap" style="background-color: {{ demo_bg }};">
                <img
                  src="{{ demo_img | asset_url }}"
                  alt="{{ demo_title }}"
                  loading="lazy"
                  width="400"
                  height="400"
                  class="twc-rp-card__img"
                  onerror="this.src='{{ 'twc-vienna-roast-1.jpg' | asset_url }}';"
                >
              </div>
            </a>

            <div class="twc-rp-card__content">
              <h3 class="twc-rp-card__title">
                <a href="/collections/all">{{ demo_title }}</a>
              </h3>

              <div class="twc-rp-card__subtitle">{{ demo_subtitle }}</div>
              <div class="twc-rp-card__notes">{{ demo_notes }}</div>

              <div class="twc-rp-card__footer">
                <button
                  type="button"
                  class="twc-rp-card__btn"
                  data-variant-id="{{ first_store_variant_id }}"
                  data-product-url="/collections/all"
                  aria-label="Add {{ demo_title }} to cart"
                >
                  <span class="twc-rp-card__btn-label">ADD TO CART</span>
                  <span class="twc-rp-card__btn-price">{{ demo_price }}</span>
                </button>
              </div>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</div>

<style>
  /* ==========================================================================
     TWC RELATED PRODUCTS SECTION ("YOU MAY ALSO LIKE")
     ========================================================================== */
  .twc-rp-{{ section.id }} {
    width: 100%;
    box-sizing: border-box;
    background-color: {{ bg_color }};
    padding-top: {{ section.settings.padding_top | default: 48 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 64 }}px;
    position: relative;
  }

  .twc-rp-{{ section.id }} *,
  .twc-rp-{{ section.id }} *::before,
  .twc-rp-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  .twc-rp-{{ section.id }} .twc-related-products__inner {
    max-width: 1400px;
    margin-left: auto;
    margin-right: auto;
    padding-left: 24px;
    padding-right: 24px;
    width: 100%;
  }

  /* Section Title */
  .twc-rp-{{ section.id }} .twc-related-products__heading {
    font-family: 'Lato', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;
    font-weight: 700 !important;
    font-size: 24px;
    line-height: 1.25 !important;
    letter-spacing: 0.5px;
    color: {{ heading_color }} !important;
    text-transform: uppercase;
    margin-top: 0;
    margin-bottom: 32px;
    text-align: left;
  }

  /* Product Grid */
  .twc-rp-{{ section.id }} .twc-related-products__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop | default: 4 }}, 1fr);
    gap: 28px;
    align-items: stretch;
    width: 100%;
  }

  /* Product Card */
  .twc-rp-{{ section.id }} .twc-rp-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    position: relative;
  }

  /* Image Box Container */
  .twc-rp-{{ section.id }} .twc-rp-card__image-link {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    text-decoration: none;
    background-color: transparent;
    border-radius: 0px;
    position: relative;
  }

  .twc-rp-{{ section.id }} .twc-rp-card__image-wrap {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
    transition: transform 0.4s ease;
  }

  .twc-rp-{{ section.id }} .twc-rp-card__img {
    width: 100%;
    height: 100%;
    object-fit: {{ section.settings.image_fit | default: 'cover' }};
    display: block;
    transition: transform 0.45s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .twc-rp-{{ section.id }} .twc-rp-card:hover .twc-rp-card__img {
    transform: scale(1.05);
  }

  /* Card Content */
  .twc-rp-{{ section.id }} .twc-rp-card__content {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    padding-top: 18px;
  }

  /* Product Title (matching method name font style) */
  .twc-rp-{{ section.id }} .twc-rp-card__title {
    font-family: 'Lato', sans-serif !important;
    font-size: 15px !important;
    font-weight: 800 !important;
    letter-spacing: 0.12em !important;
    text-transform: uppercase !important;
    color: #2D3C4B !important;
    margin: 0 0 6px 0;
    line-height: 1.35 !important;
    transition: color 0.2s ease;
  }

  .twc-rp-{{ section.id }} .twc-rp-card__title a {
    font-family: inherit !important;
    font-size: inherit !important;
    font-weight: inherit !important;
    letter-spacing: inherit !important;
    text-transform: inherit !important;
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .twc-rp-{{ section.id }} .twc-rp-card__title a:hover {
    color: #883434;
  }

  /* Subtitle (Roast Level) */
  .twc-rp-{{ section.id }} .twc-rp-card__subtitle {
    font-family: 'Merriweather', Georgia, serif !important;
    font-weight: 300 !important;
    color: #554F4F !important;
    font-size: 12px !important;
    line-height: 19px !important;
    font-style: italic !important;
    margin: 0 0 6px 0;
  }

  /* Flavor Notes */
  .twc-rp-{{ section.id }} .twc-rp-card__notes {
    font-family: 'Merriweather', Georgia, serif !important;
    font-weight: 300 !important;
    color: #554F4F !important;
    font-size: 12px !important;
    line-height: 19px !important;
    font-style: italic !important;
    margin: 0 0 16px 0;
    height: 38px;
    max-height: 38px;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Footer & Button */
  .twc-rp-{{ section.id }} .twc-rp-card__footer {
    margin-top: auto;
    display: flex;
    justify-content: flex-start;
  }

  .twc-rp-{{ section.id }} .twc-rp-card__btn {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: 40px;
    background-color: {{ btn_bg | default: '#D7D1C9' }};
    color: {{ btn_text | default: '#2D3C4B' }};
    border: none;
    border-radius: 0px 18px;
    padding-left: 30px;
    padding-right: 30px;
    font-family: 'Lato', sans-serif !important;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    text-decoration: none;
    white-space: nowrap;
    user-select: none;
  }

  .twc-rp-{{ section.id }} .twc-rp-card__btn:hover {
    background-color: {{ btn_hover_bg }};
    color: {{ btn_hover_text }};
  }

  .twc-rp-{{ section.id }} .twc-rp-card__btn:active {
    transform: scale(0.985);
  }

  .twc-rp-{{ section.id }} .twc-rp-card__btn-label {
    font-family: 'Lato', sans-serif !important;
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #2D3C4B;
  }

  .twc-rp-{{ section.id }} .twc-rp-card__btn-price {
    font-family: 'Lato', sans-serif !important;
    font-weight: 600;
    opacity: 0.95;
    text-transform: none;
    color: #2D3C4B;
  }

  .twc-rp-{{ section.id }} .twc-rp-card__btn.is-loading {
    opacity: 0.7;
    pointer-events: none;
    cursor: wait;
  }

  .twc-rp-{{ section.id }} .twc-rp-card__btn.is-success {
    background-color: #24394a !important;
    color: #ffffff !important;
  }

  .twc-rp-{{ section.id }} .twc-rp-card__btn.is-disabled,
  .twc-rp-{{ section.id }} .twc-rp-card__btn[disabled] {
    opacity: 0.55;
    cursor: not-allowed;
    background-color: #d8d3cd !important;
    color: #667085 !important;
    transform: none !important;
    box-shadow: none !important;
  }

  /* Responsive Breakpoints */
  @media (max-width: 1024px) {
    .twc-rp-{{ section.id }} .twc-related-products__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 22px;
    }
    .twc-rp-{{ section.id }} .twc-related-products__heading {
      font-size: 22px;
      margin-bottom: 26px;
    }
  }

  @media (max-width: 640px) {
    .twc-rp-{{ section.id }} {
      padding-top: 36px;
      padding-bottom: 48px;
    }
    .twc-rp-{{ section.id }} .twc-related-products__inner {
      padding-left: 16px;
      padding-right: 16px;
    }
    .twc-rp-{{ section.id }} .twc-related-products__heading {
      font-size: 18px;
      margin-bottom: 20px;
    }
    .twc-rp-{{ section.id }} .twc-related-products__grid {
      grid-template-columns: repeat({{ section.settings.columns_mobile | default: 2 }}, 1fr);
      gap: 14px;
    }
    .twc-rp-{{ section.id }} .twc-rp-card__content {
      padding-top: 12px;
    }
    .twc-rp-{{ section.id }} .twc-rp-card__title {
      font-size: 13px;
      line-height: 1.3 !important;
      margin-bottom: 4px;
    }
    .twc-rp-{{ section.id }} .twc-rp-card__subtitle {
      font-size: 11.5px;
      margin-bottom: 4px;
    }
    .twc-rp-{{ section.id }} .twc-rp-card__notes {
      font-size: 11px !important;
      line-height: 17px !important;
      height: 34px;
      max-height: 34px;
      margin-bottom: 12px;
    }
    .twc-rp-{{ section.id }} .twc-rp-card__btn {
      width: 100%;
      height: 38px;
      border-radius: 0px 18px;
      padding-left: 14px;
      padding-right: 14px;
      font-size: 10px;
      gap: 8px;
    }
  }
</style>

<script>
  (function() {
    var sectionContainer = document.getElementById('twc-rp-{{ section.id }}');
    if (!sectionContainer) return;

    // Helper: Trigger Theme Cart Drawer
    function triggerCartDrawer() {
      var cartDrawer = document.querySelector('cart-drawer') || 
                          document.querySelector('#cart-drawer') || 
                          document.getElementById('shopify-section-cart-drawer-section');
      if (cartDrawer) {
        if (typeof cartDrawer.open === 'function') {
          cartDrawer.open();
        } else if (typeof cartDrawer.show === 'function') {
          cartDrawer.show();
        } else {
          cartDrawer.setAttribute('open', '');
          cartDrawer.classList.add('is-open');
        }
      }
    }

    // Attach AJAX Add to Cart listener to buttons
    function initAddButtons(container) {
      var buttons = container.querySelectorAll('.twc-rp-card__btn:not([disabled])');
      buttons.forEach(function(btn) {
        btn.addEventListener('click', function(e) {
          e.preventDefault();
          if (btn.classList.contains('is-loading')) return;

          var variantId = btn.getAttribute('data-variant-id');
          if (!variantId) {
            var prodUrl = btn.getAttribute('data-product-url');
            if (prodUrl) window.location.href = prodUrl;
            return;
          }

          var labelEl = btn.querySelector('.twc-rp-card__btn-label');
          var origLabel = labelEl ? labelEl.textContent : 'ADD TO CART';
          
          btn.classList.add('is-loading');
          if (labelEl) labelEl.textContent = 'ADDING...';

          var postBody = {
            id: parseInt(variantId, 10),
            quantity: 1
          };

          fetch((window.Shopify && window.Shopify.routes && window.Shopify.routes.root || '/') + 'cart/add.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'X-Requested-With': 'XMLHttpRequest'
            },
            body: JSON.stringify(postBody)
          })
          .then(function(res) {
            return res.json();
          })
          .then(function(data) {
            btn.classList.remove('is-loading');
            if (data.status && data.status >= 400) {
              if (labelEl) labelEl.textContent = 'ERROR';
              setTimeout(function() {
                if (labelEl) labelEl.textContent = origLabel;
              }, 2000);
            } else {
              btn.classList.add('is-success');
              if (labelEl) labelEl.textContent = 'ADDED ✓';

              // Dispatch theme update events
              document.dispatchEvent(new CustomEvent('cart:updated', { bubbles: true }));
              document.dispatchEvent(new CustomEvent('shopify:cart:lines-update', { bubbles: true }));

              // Trigger Cart Drawer
              triggerCartDrawer();

              setTimeout(function() {
                btn.classList.remove('is-success');
                if (labelEl) labelEl.textContent = origLabel;
              }, 2500);
            }
          })
          .catch(function(err) {
            console.error('Error adding to cart:', err);
            btn.classList.remove('is-loading');
            if (labelEl) labelEl.textContent = origLabel;
          });
        });
      });
    }

    initAddButtons(sectionContainer);

    // Optional: Hydrate Shopify AI recommendations if available on product page
    var reqUrl = sectionContainer.getAttribute('data-url');
    var isProdPage = sectionContainer.getAttribute('data-product-id');
    if (reqUrl && isProdPage && window.fetch) {
      fetch(reqUrl)
        .then(function(res) { return res.text(); })
        .then(function(html) {
          var parser = new DOMParser();
          var doc = parser.parseFromString(html, 'text/html');
          var newGrid = doc.querySelector('#twc-rp-grid-{{ section.id }}');
          // Only replace if new recommendations actually contain cards and aren't empty
          if (newGrid && newGrid.querySelectorAll('.twc-rp-card:not(.is-demo-card)').length > 0) {
            var currentGrid = document.getElementById('twc-rp-grid-{{ section.id }}');
            if (currentGrid) {
              currentGrid.innerHTML = newGrid.innerHTML;
              initAddButtons(sectionContainer);
            }
          }
        })
        .catch(function() {
          // Keep current fallback gracefully
        });
    }
  })();
</script>

